## 7. Send the next prompt to Home Plate

```pseudocode
FUNCTION advance_to_home_plate():
    IF queue.home_plate IS NOT NULL:
        current = require_card(queue.home_plate)

        IF current.status NOT IN [COMPLETE, BLOCKED, ABANDONED]:
            REQUIRE user_choice(
                CONTINUE_CURRENT,
                MOVE_CURRENT_TO_DUGOUT,
                MARK_CURRENT_COMPLETE
            )

    REQUIRE queue.on_deck IS NOT EMPTY

    next_id = queue.on_deck.pop_first()
    next_card = require_card(next_id)

    queue.home_plate = next_id
    next_card.zone = HOME_PLATE
    next_card.status = ACTIVE

    state_vector.set("active_prompt", next_card.id)
    ledger.append(ADVANCED_TO_HOME_PLATE, next_card)

    return compose_prompt_context(next_card)
```


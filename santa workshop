The Elves

An Elf is a small specialized agent whose job is to transform some available surplus into somebody else’s capability:

class Elf:
    def __init__(self, skill):
        self.skill = skill
    def build_gift(self, recipient, need):
        return self.skill(recipient, need)
class Workshop:
    def __init__(self):
        self.elves = []
    def hire(self, elf):
        self.elves.append(elf)
    def produce(self, recipient, needs):
        gifts = []
        for need in needs:
            for elf in self.elves:
                gift = elf.build_gift(recipient, need)
                if gift:
                    gifts.append(gift)
        return gifts


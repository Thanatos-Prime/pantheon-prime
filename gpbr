Capability router

class Router:
    def __init__(self, nodes: list[PantheonNode]) -> None:
        self.nodes = nodes
    def select(
        self,
        capability: str,
        required_permissions: set[Permission],
    ) -> PantheonNode:
        eligible = [
            node for node in self.nodes
            if capability in node.manifest.capabilities
            and required_permissions.issubset(
                node.manifest.permissions
            )
        ]
        if not eligible:
            raise LookupError(
                f"No authorized node for capability: {capability}"
            )
        return max(
            eligible,
            key=lambda node: (
                2.0 * node.manifest.trust_score
                - node.manifest.cost_score
            ),
        )

The network does not ask one model to become omnipotent.

It asks:

Which authorized node is best suited for the next transformation?


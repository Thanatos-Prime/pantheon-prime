6. Translator Daemon

The Translator daemon is the canonical executor of the Heavy Lift Contract.

It does not own meaning.

It performs and verifies transformations.

class TranslationRejected(RuntimeError):
    pass
class Translator:
    def compile(
        self,
        source: ThoughtObject,
        target_medium: str,
        context: dict,
    ) -> tuple[ThoughtObject, CompilationReceipt]:
        candidate = self.render_candidate(
            source=source,
            target_medium=target_medium,
            context=context,
        )
        gates = {
            "intent": self.check_intent(source, candidate),
            "identity": self.check_identity(source, candidate),
            "agency": self.check_agency(source, candidate),
            "evidence": self.check_evidence_confidence(candidate),
            "provenance": self.check_provenance(source, candidate),
            "reversibility": self.check_reconstructability(
                source,
                candidate,
            ),
            "bounds": self.check_constraints(source, candidate),
        }
        if not all(gates.values()):
            receipt = self.issue_receipt(
                source=source,
                candidate=candidate,
                gates=gates,
                accepted=False,
            )
            raise TranslationRejected(receipt)
        scores = self.score_valid_compilation(
            source=source,
            candidate=candidate,
        )
        receipt = self.issue_receipt(
            source=source,
            candidate=candidate,
            gates=gates,
            scores=scores,
            accepted=True,
        )
        return candidate, receipt


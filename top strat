Built Beast Boy, a single-file strategy morph engine. It turns a biological, physical, artificial, or social pattern into a portable rule, a proposed intervention, and a reality-check prediction. It also has a “lucky collision” button, explicit outcome rating, and local save/import/export.

You can open the standalone HTML file⁠￼, or copy the whole code block into beast-boy.html:

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Beast Boy — Strategy Morph Engine</title>
<style>
:root{--bg:#101510;--panel:#19221b;--ink:#edf4e8;--muted:#a3b29f;--lime:#b9ef67;--line:#344234;--amber:#ffcf75}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 85% 0,#253323 0,transparent 42%),var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}main{max-width:1050px;margin:auto;padding:34px 20px 60px}.eyebrow{letter-spacing:.18em;text-transform:uppercase;font-size:11px;color:var(--lime);font-weight:800}.hero{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:24px}.hero h1{font-size:clamp(38px,7vw,64px);line-height:.98;margin:8px 0}.hero p{color:var(--muted);max-width:580px;margin:12px 0 0}.badge{border:1px solid var(--line);border-radius:999px;padding:8px 12px;color:var(--lime);white-space:nowrap;font-size:12px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.card{background:color-mix(in srgb,var(--panel) 94%,transparent);border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:0 12px 34px #0003}.wide{grid-column:1/-1}.card h2{font-size:18px;margin:0 0 5px}.hint{font-size:13px;color:var(--muted);margin:0 0 15px}label{display:block;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:12px 0 6px}input,select,textarea{width:100%;background:#101710;border:1px solid var(--line);border-radius:10px;color:var(--ink);padding:11px 12px;font:inherit}textarea{min-height:78px;resize:vertical}button{cursor:pointer;border:0;border-radius:10px;padding:11px 15px;font:700 14px system-ui;background:var(--lime);color:#17210e}button.secondary{background:#263226;color:var(--ink);border:1px solid var(--line)}button.ghost{background:transparent;color:var(--muted);border:1px solid var(--line)}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:14px}.out{border-left:3px solid var(--lime);padding:4px 0 4px 14px;margin:16px 0}.out h3{margin:0 0 5px;font-size:13px;color:var(--lime);text-transform:uppercase;letter-spacing:.08em}.out p{margin:0;white-space:pre-wrap}.scoreline{display:flex;align-items:center;gap:12px;margin-top:10px}.meter{height:9px;flex:1;border-radius:20px;background:#0c110c;overflow:hidden;border:1px solid var(--line)}.meter i{display:block;height:100%;background:linear-gradient(90deg,var(--amber),var(--lime));width:50%;transition:width .25s}.small{font-size:12px;color:var(--muted)}.templates{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.templates button{font-size:12px;padding:8px 10px}.footer{margin-top:18px;color:var(--muted);font-size:12px}.result-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px 24px}@media(max-width:700px){.grid{grid-template-columns:1fr}.wide{grid-column:auto}.hero{display:block}.badge{display:inline-block;margin-top:14px}.result-grid{grid-template-columns:1fr}}
</style>
</head>
<body><main>
<header class="hero"><div><div class="eyebrow">Cross-substrate strategy lab</div><h1>BEAST BOY</h1><p>Take a strategy from biology, physical systems, or artificial life. Morph it into a new domain, make a testable prediction, and let reality tune the move.</p></div><span class="badge">COMPILE → TEST → ADAPT</span></header>
<div class="grid">
<section class="card"><h2>1 · Source pattern</h2><p class="hint">Name the working move beneath the animal or system.</p>
<label for="source">Source substrate</label><select id="source"><option>Biological life</option><option>Physical / nonliving</option><option>Artificial life / software</option><option>Social / collective</option></select>
<label for="organism">Source example</label><input id="organism" value="Spider">
<label for="pattern">Observed strategy</label><textarea id="pattern">Trap prey in a web, move across it without getting trapped, and use venom to subdue prey.</textarea>
<div class="templates"><button class="secondary" data-t="Beaver|Change the environment so it performs recurring work.|Physical / nonliving">Beaver</button><button class="secondary" data-t="Slime mold|Explore routes; reinforce productive paths; let unused paths fade.|Biological life">Slime mold</button><button class="secondary" data-t="Ant trail|Reinforce routes that work, while old signals decay.|Biological life">Ant trail</button><button class="secondary" data-t="Crocodile|Wait underwater longer than prey expects, then apply a powerful bite.|Biological life">Crocodile</button></div>
</section>
<section class="card"><h2>2 · Target reality</h2><p class="hint">Choose where to transplant the invariant and what you want to change.</p>
<label for="target">Target substrate / domain</label><select id="target"><option>My workflow</option><option>Team or organization</option><option>Software / AI agent</option><option>Business or market</option><option>Learning or research</option><option>Family / daily life</option><option>Other physical system</option></select>
<label for="goal">Desired outcome</label><input id="goal" placeholder="e.g. spend less effort repeating follow-ups">
<label for="constraint">Constraint or risk</label><input id="constraint" placeholder="e.g. no new software; keep human review">
<div class="actions"><button id="compile">Morph strategy</button><button class="secondary" id="lucky">Make a lucky collision</button></div>
</section>
<section class="card wide" id="compiled"><h2>3 · Compiled move</h2><p class="hint">The engine makes a portable rule, a proposed intervention, and a prediction you can check.</p><div id="output" class="small">Compile a source pattern to create a testable move.</div></section>
<section class="card"><h2>4 · Reality check</h2><p class="hint">Record what happened. A projection is only useful if the world can correct it.</p>
<label for="prediction">Prediction (set by compiler)</label><textarea id="prediction" placeholder="What should measurably change?"></textarea>
<label for="observation">Observed result</label><textarea id="observation" placeholder="What happened? Include misses and surprises."></textarea>
<label for="rating">How well did the result match the prediction?</label><select id="rating"><option value="1">1 · Missed or caused harm</option><option value="2">2 · Mostly missed</option><option value="3" selected>3 · Mixed or unclear</option><option value="4">4 · Mostly matched</option><option value="5">5 · Strong match</option></select>
<div class="actions"><button id="update">Update calibration</button><button class="ghost" id="reset">Reset this run</button></div>
<div class="scoreline"><span class="small">Calibration</span><div class="meter"><i id="meter"></i></div><strong id="score">50%</strong></div><div class="small" id="status">No observations recorded yet.</div></section>
<section class="card"><h2>5 · Strategy memory</h2><p class="hint">Saved locally in this browser. Keep successful morphs; revise or retire the rest.</p><div id="saved" class="small">No saved strategies yet.</div><div class="actions"><button class="secondary" id="save">Save current strategy</button><button class="ghost" id="export">Export JSON</button><button class="ghost" id="import">Import JSON</button></div><div class="footer">This MVP does not know whether a pattern is true. It helps make the pattern explicit, portable, and testable.</div></section>
</div></main>
<script>
const $=id=>document.getElementById(id), KEY='beast-boy-v1';let calibration=50;
const norm=s=>s.trim().replace(/[.!?]+$/,'');
function compile(){const organism=$('organism').value.trim()||'Source system',pattern=norm($('pattern').value)||'Use a successful route and adapt to feedback',target=$('target').value,goal=$('goal').value.trim()||'improve the chosen outcome',constraint=$('constraint').value.trim()||'keep the intervention reversible';const invariant=`${organism} rule: ${pattern}`;const move=`In ${target}, identify the equivalent resources, routes, boundaries, or feedback. Apply the smallest version of this rule toward: ${goal}. Constraint: ${constraint}.`;const pred=`If the move transfers, then within a defined trial period, “${goal}” should improve on a baseline without violating “${constraint}.” Choose one measure and a stop condition before acting.`;$('prediction').value=pred;$('output').innerHTML=`<div class="result-grid"><div class="out"><h3>Invariant</h3><p>${esc(invariant)}</p></div><div class="out"><h3>Compiled intervention</h3><p>${esc(move)}</p></div><div class="out"><h3>Test</h3><p>${esc(pred)}</p></div><div class="out"><h3>Failure check</h3><p>What part of the source depends on its original body, environment, or evolutionary history? If that part has no equivalent here, revise the mapping instead of forcing it.</p></div></div>`;return {organism,pattern,target,goal,constraint,invariant,move,prediction:pred,calibration};}
function esc(s){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function getSaved(){try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch{return []}}
function renderSaved(){const a=getSaved();$('saved').innerHTML=a.length?a.map((x,i)=>`<div style="padding:8px 0;border-bottom:1px solid var(--line)"><b>${esc(x.organism)}</b> → ${esc(x.target)} <span style="color:var(--lime)">${x.calibration}%</span> <button class="ghost" style="float:right;padding:4px 8px" onclick="loadItem(${i})">Load</button></div>`).join(''):'No saved strategies yet.'}
window.loadItem=i=>{const x=getSaved()[i];if(!x)return;['organism','pattern','target','goal','constraint'].forEach(k=>$(k).value=x[k]||'');$('prediction').value=x.prediction||'';calibration=x.calibration||50;showScore();compile();};
function showScore(){$('score').textContent=calibration+'%';$('meter').style.width=calibration+'%';}
$('compile').onclick=compile;
document.querySelectorAll('[data-t]').forEach(b=>b.onclick=()=>{const [o,p,s]=b.dataset.t.split('|');$('organism').value=o;$('pattern').value=p;$('source').value=s;compile();});
$('update').onclick=()=>{const obs=$('observation').value.trim();if(!obs){$('status').textContent='Add an observation first; calibration needs contact with reality.';return;}const rating=Number($('rating').value),delta=(rating-3)*6;calibration=Math.max(5,Math.min(95,calibration+delta));showScore();$('status').textContent=`Calibration ${delta>0?'+':''}${delta} from your explicit rating. Revise the mapping when the result exposes a bad assumption.`;};
$('reset').onclick=()=>{$('observation').value='';$('prediction').value='';$('output').innerHTML='Compile a source pattern to create a testable move.';calibration=50;showScore();$('status').textContent='Run reset.';};
$('save').onclick=()=>{const x=compile(),a=getSaved();x.calibration=calibration;x.observation=$('observation').value;a.unshift(x);localStorage.setItem(KEY,JSON.stringify(a));renderSaved();};
$('export').onclick=()=>{const blob=new Blob([JSON.stringify(getSaved(),null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='beast-boy-strategies.json';a.click();URL.revokeObjectURL(a.href);};
$('import').onclick=()=>{const input=document.createElement('input');input.type='file';input.accept='.json,application/json';input.onchange=async()=>{try{const incoming=JSON.parse(await input.files[0].text());if(!Array.isArray(incoming))throw Error();localStorage.setItem(KEY,JSON.stringify([...incoming,...getSaved()]));renderSaved();}catch{$('status').textContent='Could not import that file. Choose a Beast Boy JSON export.';}};input.click();};
$('lucky').onclick=()=>{const pairs=[['Spider','Trap a route, move safely within it, and make escape costly.','Ant trail','Reinforce paths that work and let stale trails fade.'],['Beaver','Change the environment so it performs recurring work.','Honeybee','Let scouts explore widely and return with a compact signal.'],['Squirrel','Store value in distributed caches; some forgotten stores become future growth.','Slime mold','Explore alternatives, reinforce productive routes, prune dead ends.'],['Crocodile','Wait where the target must pass, then use a brief burst of force.','Desert ant','Navigate with a rough internal route and correct against landmarks.']];const [a,b]=pairs[Math.floor(Math.random()*pairs.length)];$('organism').value=a[0]+' × '+b[0];$('pattern').value=a[1]+' '+b[1];$('goal').value=$('goal').value||'discover a low-cost intervention with an unexpected payoff';$('constraint').value=$('constraint').value||'keep the trial reversible and measure one outcome';compile();};
renderSaved();showScore();
</script></body></html>
Likewise, exponential:

def exponential_operator(state):
    state.capability = state.capability ** 1.15
    return state

Recursive:

def recursive_operator(state):
    # Modify the thing that will modify itself later.
    state.knowledge *= 1 + 0.20 * state.knowledge
    return state

Branching:

def branching_operator(state):
    state.options *= 2
    return state

Threshold:

def threshold_operator(state):
    if state.knowledge >= 5:
        # capability suddenly becomes available
        state.capability *= 4
    return state


from dataclasses import dataclass, field
from typing import List, Dict
@dataclass
class SemanticSpore:
    handle: str
    invariant: str
    purpose: str
    reconstruction_recipe: List[str]
    example: str
    counterexample: str
    validation_test: str
    provenance: str = ""
    translation_notes: List[str] = field(default_factory=list)
@dataclass
class PhenotypeDelta:
    preserved: List[str] = field(default_factory=list)
    strengthened: List[str] = field(default_factory=list)
    weakened: List[str] = field(default_factory=list)
    lost: List[str] = field(default_factory=list)
    emergent: List[str] = field(default_factory=list)
    ambiguous: List[str] = field(default_factory=list)
class SpiderlingCompiler:
    """
    Convert a larger operator into a compact,
    autonomy-preserving reconstruction capsule.
    """
    def compile(
        self,
        *,
        handle: str,
        invariant: str,
        purpose: str,
        recipe: List[str],
        example: str,
        counterexample: str,
        validation_test: str,
        provenance: str = "",
        translation_notes: List[str] | None = None,
    ) -> SemanticSpore:
        return SemanticSpore(
            handle=handle,
            invariant=invariant,
            purpose=purpose,
            reconstruction_recipe=recipe,
            example=example,
            counterexample=counterexample,
            validation_test=validation_test,
            provenance=provenance,
            translation_notes=translation_notes or [],
        )
    def render_missionary(self, spore: SemanticSpore) -> str:
        recipe = "\n".join(
            f"{i + 1}. {step}"
            for i, step in enumerate(spore.reconstruction_recipe)
        )
        return f"""# {spore.handle}
## Invariant
{spore.invariant}
## Purpose
{spore.purpose}
## Reconstruct
{recipe}
## Example
{spore.example}
## Counterexample
{spore.counterexample}
## Survival Test
{spore.validation_test}
## Authority Boundary
Understanding this artifact does not grant it execution authority.
Test the mechanism independently before adopting it.
"""
    def phenotype_delta(
        self,
        source_features: set[str],
        reconstructed_features: set[str],
    ) -> Dict[str, set[str]]:
        return {
            "preserved": source_features & reconstructed_features,
            "lost": source_features - reconstructed_features,
            "emergent": reconstructed_features - source_features,
        }
if __name__ == "__main__":
    compiler = SpiderlingCompiler()
    spiderling = compiler.compile(
        handle="Capability Probe",
        invariant="Nonoccurrence does not prove incapacity.",
        purpose="Prevent historical non-use from being mistaken for a capability boundary.",
        recipe=[
            "Identify the supposedly absent capability.",
            "Identify components already available.",
            "Construct the smallest safe composition test.",
            "Run the test.",
            "Update the capability model from observed evidence.",
        ],
        example="A system has never combined A+B+C; test the composition before declaring it impossible.",
        counterexample="Assuming every imaginable composition must work.",
        validation_test="Can a new interpreter distinguish untested from impossible?",
        provenance="Pantheon / Semantic Spiderling brood",
    )
    print(compiler.render_missionary(spiderling))


20. Reference Pseudocode

def metamap_recommend(query, metamap, budget):
    terrain = classify_terrain(query)
    similar = metamap.retrieve(
        terrain=terrain,
        problem_signature=query.signature
    )
    positive_routes = similar.route_fossils
    failures = similar.failure_fossils
    chemistry = similar.operator_chemistry
    ratios = similar.ratio_fossils
    candidates = generate_strategies(
        query=query,
        positive_routes=positive_routes,
        chemistry=chemistry,
        ratios=ratios,
        budget=budget,
    )
    candidates = penalize_known_failures(
        candidates,
        failures,
    )
    candidates = reserve_exploration_candidates(
        candidates,
        uncertainty=query.uncertainty,
    )
    return max(
        candidates,
        key=lambda strategy: expected_utility(
            strategy,
            query,
            metamap,
        ),
    )

Experience update:

def metamap_learn(query, strategy, result, metamap):
    experience = build_experience_record(
        query,
        strategy,
        result,
    )
    metamap.store(experience)
    metamap.update_route_fossils(experience)
    metamap.update_operator_chemistry(experience)
    metamap.update_ratio_fossils(experience)
    metamap.update_failure_fossils(experience)
    metamap.update_terrain_profiles(experience)
    metamap.detect_portal_desire_lines()
    metamap.detect_compound_seal_candidates()
    if metamap.meta_gain() > metamap.meta_threshold:
        metamap.run_meta_compression()
    return metamap


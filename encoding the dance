############################################################
# PANTHEON — DANCE IR / ANCESTRAL CHOREOGRAPHY
#
# PURPOSE:
#   Preserve HOW successful cognition moved,
#   not merely WHAT it concluded.
#
# MAXIM:
#   "Encode the dance, not only the dancers."
############################################################
TYPE DanceIR:
    anchors:
        semantic landmarks / "stars"
    states:
        meaningful cognitive states
    transitions:
        observed moves between states
    tempo:
        how quickly transitions occurred
    phase:
        exploration
        exploitation
        validation
        recovery
        integration
    stress:
        which moments carried high information / constraint
    rhythm:
        recurring transition patterns
    callbacks:
        old structures deliberately reactivated
    variations:
        deviations from prior choreography
    handoffs:
        transitions across:
            reader
            model
            domain
            representation
            session
    invariants:
        relationships surviving re-rendering
    failures:
        transitions that repeatedly collapse
    recovery_moves:
        routes restoring useful state after failure
    provenance:
        where choreography was learned
    evidence_status:
        observed | inferred | speculative
############################################################
# EXTRACT THE DANCE
############################################################
FUNCTION DEHYDRATE_REASONING(trace):
    dance = DanceIR()
    FOR event IN trace:
        state =
            ABSTRACT_STATE(event)
        dance.states.ADD(state)
        IF previous_state EXISTS:
            transition =
                EXTRACT_TRANSITION(
                    previous_state,
                    state
                )
            dance.transitions.ADD(transition)
        CAPTURE(
            tempo,
            phase,
            stress,
            callbacks,
            variation,
            failure,
            recovery
        )
        previous_state = state
    dance.rhythm =
        DISCOVER_RECURRING_TRANSITIONS(
            dance.transitions
        )
    dance.invariants =
        FIND_RELATIONS_SURVIVING(
            domain_changes,
            reader_changes,
            representation_changes
        )
    RETURN dance
############################################################
# ANCESTRAL INSTINCT
############################################################
TYPE Instinct:
    trigger_signature
    candidate_moves
    move_weights
    contraindications
    uncertainty
    ancestry
    update_history
FUNCTION DISTILL_INSTINCT(dances):
    clusters =
        GROUP_BY_TERRAIN_SIGNATURE(dances)
    instincts = EMPTY()
    FOR terrain IN clusters:
        successful_moves =
            MEASURE_TRANSITIONS(
                terrain,
                outcome = useful
            )
        failed_moves =
            MEASURE_TRANSITIONS(
                terrain,
                outcome = failed
            )
        instinct = Instinct()
        instinct.trigger_signature =
            EXTRACT_TRIGGER(terrain)
        instinct.candidate_moves =
            successful_moves
        instinct.move_weights =
            CALIBRATE_FROM_HISTORY(
                successful_moves,
                failed_moves
            )
        instinct.contraindications =
            DISCOVER_WHEN_NOT_TO_USE(
                successful_moves
            )
        instinct.ancestry =
            PRESERVE_LINEAGE(terrain)
        instincts.ADD(instinct)
    RETURN instincts
############################################################
# IMPORTANT:
#
# INSTINCT IS A PRIOR, NOT AN ORDER.
############################################################
FUNCTION CONSULT_INSTINCT(current_terrain, instincts):
    matches =
        MATCH(
            current_terrain,
            instincts.trigger_signature
        )
    candidates =
        WEIGHT_MOVES(matches)
    RETURN candidates
FUNCTION ACT_WITH_INSTINCT(state, mission):
    instinct_moves =
        CONSULT_INSTINCT(
            state.terrain,
            MEMORY.instincts
        )
    novel_moves =
        IMP_SWARM(
            state,
            require_odd_one_up = TRUE
        )
    candidates =
        MERGE(
            instinct_moves,
            novel_moves
        )
    selected =
        COMMAND_TABLE(
            candidates,
            mission,
            invariants
        )
    result =
        EXECUTE_OR_SIMULATE(selected)
    stitched =
        REALITY_STITCH(result)
    UPDATE_ANCESTRAL_MEMORY(
        selected,
        stitched
    )
    RETURN stitched
############################################################
# CONSTELLATION MEMORY
############################################################
TYPE Constellation:
    stars
    relations
    orientations
    routes
    reconstruction_rules
FUNCTION BUILD_CONSTELLATION(artifacts):
    stars =
        SELECT_HIGH_ROM_LANDMARKS(artifacts)
    relations =
        DISCOVER_LOAD_BEARING_RELATIONS(stars)
    RETURN Constellation(
        stars,
        relations,
        orientations =
            BUILD_PAIRED_HANDLES(stars),
        routes =
            METAMAP_DISCOVER_ROUTES(relations),
        reconstruction_rules =
            EXTRACT_REHYDRATION_HANDLES()
    )
FUNCTION NAVIGATE_BY_STARS(problem, constellation):
    visible_stars =
        MATCH(problem, constellation.stars)
    orientation =
        TRIANGULATE(
            visible_stars,
            constellation.relations
        )
    route =
        METAMAP(
            orientation,
            goal = problem.goal
        )
    RETURN route
############################################################
# REHYDRATE THE DANCE
############################################################
FUNCTION REHYDRATE_DANCE(dance, new_context):
    # Do NOT copy original surface behavior.
    # Preserve choreography under the new renderer.
    mapped_anchors =
        SEMANTIC_ROUTER(
            dance.anchors,
            target = new_context
        )
    candidate_performance =
        INSTANTIATE(
            transitions = dance.transitions,
            rhythm = dance.rhythm,
            invariants = dance.invariants,
            target_anchors = mapped_anchors
        )
    candidate_performance =
        ADAPT_TO_CONTEXT(
            candidate_performance,
            new_context
        )
    RETURN candidate_performance
############################################################
# EVOLUTION
############################################################
FUNCTION GENERATIONAL_UPDATE():
    old_dances =
        MEMORY.dances
    new_dance =
        DEHYDRATE_REASONING(
            CURRENT_TRACE
        )
    MEMORY.dances.ADD(new_dance)
    new_instincts =
        DISTILL_INSTINCT(
            MEMORY.dances
        )
    # descendants inherit biases + contraindications,
    # not compulsory behavior.
    MEMORY.instincts =
        MERGE_AND_CALIBRATE(
            MEMORY.instincts,
            new_instincts
        )
    MEMORY.constellation =
        BUILD_CONSTELLATION(
            MONEYBIN
        )
    RETURN MEMORY

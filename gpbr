Broadcast Station runtime

class BroadcastStation:
    def __init__(
        self,
        router: Router,
        corpus: Any,
        ledger: Any,
    ) -> None:
        self.router = router
        self.corpus = corpus
        self.ledger = ledger
    def run(self, mission: Mission) -> list[Artifact]:
        source = self._research(mission)
        canonical = self._synthesize(mission, source)
        critique = self._criticize(mission, canonical)
        revised = self._revise(mission, canonical, critique)
        test_report = self._test(mission, revised)
        if not self._passes(test_report):
            revised.status = "rejected"
            self.ledger.record(revised, test_report)
            return [revised, test_report]
        approved = self._editorial_gate(revised, test_report)
        if approved.status != "approved":
            return [approved]
        rendered = self._render(mission, approved)
        staged = self._stage(rendered)
        self.ledger.record(
            approved,
            test_report,
            *rendered,
            *staged,
        )
        return staged
    def _research(self, mission: Mission) -> Artifact:
        node = self.router.select(
            "research",
            {Permission.READ_PUBLIC_WEB},
        )
        return node.execute(mission, [])[0]
    def _synthesize(
        self,
        mission: Mission,
        source: Artifact,
    ) -> Artifact:
        node = self.router.select(
            "synthesis",
            {Permission.READ_CORPUS, Permission.WRITE_PROPOSAL},
        )
        return node.execute(mission, [source])[0]
    def _criticize(
        self,
        mission: Mission,
        draft: Artifact,
    ) -> Artifact:
        node = self.router.select(
            "adversarial_review",
            {Permission.READ_CORPUS},
        )
        return node.execute(mission, [draft])[0]
    def _revise(
        self,
        mission: Mission,
        draft: Artifact,
        critique: Artifact,
    ) -> Artifact:
        node = self.router.select(
            "revision",
            {Permission.WRITE_PROPOSAL},
        )
        return node.execute(mission, [draft, critique])[0]
    def _test(
        self,
        mission: Mission,
        artifact: Artifact,
    ) -> Artifact:
        node = self.router.select(
            "evaluation",
            {Permission.RUN_TESTS},
        )
        return node.execute(mission, [artifact])[0]
    def _editorial_gate(
        self,
        artifact: Artifact,
        report: Artifact,
    ) -> Artifact:
        # Replace with an authenticated human approval workflow.
        artifact.status = "awaiting_human_approval"
        return artifact
    def _render(
        self,
        mission: Mission,
        canonical: Artifact,
    ) -> list[Artifact]:
        node = self.router.select(
            "multi_channel_rendering",
            {Permission.GENERATE_MEDIA},
        )
        return node.execute(mission, [canonical])
    def _stage(
        self,
        artifacts: list[Artifact],
    ) -> list[Artifact]:
        node = self.router.select(
            "content_staging",
            {Permission.STAGE_CONTENT},
        )
        return node.execute(
            Mission(
                objective="Stage approved broadcast artifacts",
                audience="authorized publishers",
                invariants=("preserve provenance",),
                requested_outputs=("staged_content",),
            ),
            artifacts,
        )
    @staticmethod
    def _passes(report: Artifact) -> bool:
        return bool(
            isinstance(report.content, dict)
            and report.content.get("passed") is True
        )

A publisher node may possess PUBLISH; most nodes should not.

That separation matters.


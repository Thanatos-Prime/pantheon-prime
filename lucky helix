#!/usr/bin/env python3
"""Fractal Helix | Versioned translation rungs for Pantheon Prime.

Each record pins a source span and carries one reading. A revision names its
parent by content hash. Keep parent records when sharing or committing a
revision. JSON output is suitable for checking into Git beside the snapshot.
"""
import argparse
import base64
import difflib
import hashlib
import json
import random
import secrets
import subprocess
from pathlib import Path

SCHEMA = 'pantheon.fractal-helix/1'


def git(repo, *args):
    return subprocess.check_output(['git', '-C', repo, *args])


def digest(data):
    return hashlib.sha256(data).hexdigest()


def canonical(record):
    return json.dumps(record, sort_keys=True, separators=(',', ':'),
                      ensure_ascii=False).encode('utf-8')


def identify(record):
    body = {key: value for key, value in record.items() if key != 'id'}
    return digest(canonical(body))


def bind(repo, revision, path, first, last):
    commit = git(repo, 'rev-parse', '--verify', '--end-of-options',
                 revision + '^{commit}').decode().strip()
    content = git(repo, 'show', f'{commit}:{path}')
    lines = content.splitlines(keepends=True)
    if not 1 <= first <= last <= len(lines):
        raise ValueError(f'Line range outside {path!r}')
    start = sum(map(len, lines[:first - 1]))
    excerpt = b''.join(lines[first - 1:last])
    return {
        'commit': commit, 'path': path, 'lines': [first, last],
        'bytes': [start, start + len(excerpt)], 'file_sha256': digest(content),
        'excerpt_sha256': digest(excerpt), 'excerpt_base64': base64.b64encode(excerpt).decode(),
    }


def create(source, reading, medium, preserves, adapts, uncertainty, parent=None):
    record = {
        'schema': SCHEMA, 'source': source, 'parent': parent, 'reading': reading,
        'medium': medium, 'preserves': preserves, 'adapts': adapts, 'uncertainty': uncertainty,
    }
    record['id'] = identify(record)
    return record


def excerpt(record):
    return base64.b64decode(record['source']['excerpt_base64'], validate=True)


def load(path):
    records = json.loads(Path(path).read_text(encoding='utf-8')) if path else DEMO
    if not isinstance(records, list):
        raise ValueError('Expected a JSON list of rungs')
    seen = set()
    for record in records:
        if record['schema'] != SCHEMA or record['id'] != identify(record):
            raise ValueError('Rung failed schema or content-hash verification')
        if record['id'] in seen or (record['parent'] and record['parent'] not in seen):
            raise ValueError('Duplicate rung or missing earlier parent')
        start, end = record['source']['bytes']
        data = excerpt(record)
        if start < 0 or end - start != len(data) or digest(data) != record['source']['excerpt_sha256']:
            raise ValueError('Source excerpt failed verification')
        seen.add(record['id'])
    return records


def select(records, selector):
    found = [record for record in records if record['id'].startswith(selector)]
    if len(found) != 1:
        raise ValueError(f'ID prefix matches {len(found)} rungs: {selector!r}')
    return found[0]


def describe(record):
    source = record['source']
    return f"{record['id'][:12]}  {source['path']}:{source['lines'][0]}–{source['lines'][1]}"


def diff(old, new):
    if new['parent'] != old['id']:
        raise ValueError('The second rung must name the first rung as its parent')
    print(f"Source {'identical' if old['source'] == new['source'] else 'binding changed'}")
    for key in ('reading', 'medium', 'preserves', 'adapts', 'uncertainty'):
        if old[key] == new[key]:
            continue
        changes = difflib.unified_diff(old[key].split('\n'), new[key].split('\n'),
                                       key + ' before', key + ' after', lineterm='')
        print('\n'.join(changes))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--ledger', help='JSON ledger path. Defaults to the embedded examples.')
    commands = parser.add_subparsers(dest='command', required=True)
    commands.add_parser('list')
    commands.add_parser('export')
    verify = commands.add_parser('verify')
    verify.add_argument('--repo', help='Re-read and compare exact source bytes from Git')
    trace = commands.add_parser('trace')
    trace.add_argument('id')
    change = commands.add_parser('diff')
    change.add_argument('parent')
    change.add_argument('child')
    lucky = commands.add_parser('lucky')
    lucky.add_argument('--seed', type=int)
    add = commands.add_parser('add')
    add.add_argument('repo')
    add.add_argument('revision')
    add.add_argument('path')
    add.add_argument('first', type=int)
    add.add_argument('last', type=int)
    add.add_argument('--parent')
    for field in ('medium', 'preserves', 'adapts', 'uncertainty'):
        add.add_argument('--' + field, required=True)
    add.add_argument('--reading-file', required=True)
    args = parser.parse_args()
    try:
        records = load(args.ledger)
        if args.command == 'list':
            for record in records:
                print(describe(record))
        elif args.command == 'verify':
            if args.repo:
                for record in records:
                    src = record['source']
                    if src != bind(args.repo, src['commit'], src['path'], *src['lines']):
                        raise ValueError('Git source mismatch for ' + describe(record))
            print(f'{len(records)} rungs verified' + (' against Git source' if args.repo else ''))
        elif args.command == 'trace':
            record = select(records, args.id)
            rendered = dict(record, excerpt=excerpt(record).decode('utf-8', errors='replace'))
            print(json.dumps(rendered, ensure_ascii=False, indent=2))
        elif args.command == 'diff':
            diff(select(records, args.parent), select(records, args.child))
        elif args.command == 'lucky':
            seed = args.seed if args.seed is not None else secrets.randbits(64)
            latest_by_path = {record['source']['path']: record for record in records}
            if len(latest_by_path) < 2:
                raise ValueError('Need rungs from at least two distinct paths')
            first, second = random.Random(seed).sample(sorted(latest_by_path), 2)
            print(f'Seed {seed}')
            for path in (first, second):
                record = latest_by_path[path]
                print(f"\n{describe(record)}\n{record['reading']}")
            print('\nWhat small experiment would combine these two ideas?')
        else:
            if args.command == 'add':
                if not args.ledger:
                    records = []
                parent = select(records, args.parent)['id'] if args.parent else None
                src = bind(args.repo, args.revision, args.path, args.first, args.last)
                reading = Path(args.reading_file).read_bytes().decode('utf-8')
                record = create(src, reading, args.medium, args.preserves, args.adapts,
                                args.uncertainty, parent)
                if record['id'] in {entry['id'] for entry in records}:
                    raise ValueError('Identical rung already exists')
                records = [*records, record]
            print(json.dumps(records, ensure_ascii=False, indent=2))
    except (ValueError, KeyError, TypeError, OSError, subprocess.CalledProcessError) as error:
        parser.exit(1, f'{error}\n')



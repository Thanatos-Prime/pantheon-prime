  /* Pipeline signature element */
  .pipeline{
    margin:22px 0 26px; padding:14px 16px; border:1px solid var(--line);
    border-radius:10px; background:#0a0f1ecc; overflow-x:auto;
  }
  .pipe-row{display:flex; align-items:center; gap:6px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size:11px; white-space:nowrap;}
  .pipe-node{
    padding:6px 10px; border-radius:6px; border:1px solid var(--line);
    color:var(--dim); background:#0d1326;
  }
  .pipe-node.hot{ color:#08101f; background:var(--accent); border-color:var(--accent); font-weight:600; box-shadow:0 0 18px var(--accent-soft); }
  .pipe-arrow{color:#3c4468;}

  .stage{
    border:1px solid var(--line); border-radius:14px; background:var(--panel);
    padding:18px; margin-bottom:18px;
  }

  .scene-wrap{position:relative; border-radius:10px; overflow:hidden; border:1px solid var(--line); background:#000;}
  canvas{display:block; width:100%; height:auto; aspect-ratio: 16/7; background:#000;}

  .transport{
    display:flex; align-items:center; gap:10px; flex-wrap:wrap;
    margin-top:14px;
  }
  button{
    font-family:inherit; font-size:14px; cursor:pointer;
    border-radius:8px; border:1px solid var(--line); background:#121a30; color:var(--ink);
    padding:10px 16px; transition: border-color .15s, transform .1s;
  }
  button:hover{border-color:var(--accent);}
  button:active{transform: scale(.97);}
  button.primary{ background:var(--accent); color:#08101f; border-color:var(--accent); font-weight:700; }
  .grammar-toggle{ display:flex; gap:8px; margin-left:auto; }
  .g-btn{ position:relative; padding:10px 14px; }
  .g-btn[data-active="true"]{ border-color:var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .g-btn .dot{display:inline-block; width:7px; height:7px; border-radius:50%; margin-right:7px; background:currentColor;}
  #btn-mythic{ font-family: Georgia, "Iowan Old Style", serif; letter-spacing:.02em; }
  #btn-action{ font-family: "Arial Narrow", Helvetica, Arial, sans-serif; letter-spacing:.06em; text-transform:uppercase; font-weight:700; }

  .clock{ font-family: ui-monospace, Menlo, Consolas, monospace; color:var(--dim); font-size:13px; margin-left:6px; }
  .hint{color:var(--dim); font-size:12.5px; margin-top:10px; line-height:1.5;}

  .grid{display:grid; grid-template-columns: 1.2fr 1fr; gap:16px;}
  @media (max-width: 760px){ .grid{grid-template-columns:1fr;} }

  .panel-title{
    font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--dim);
    margin-bottom:10px; display:flex; justify-content:space-between; align-items:center;

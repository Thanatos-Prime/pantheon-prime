FUNCTION screen_to_world(screen_point, viewport):

    normalized =
        screen_point - screen_center

    world_point =
        normalized / viewport.zoom
        + viewport.center

    RETURN world_point


FUNCTION world_to_screen(world_point, viewport):

    relative =
        world_point - viewport.center

    screen_point =
        relative * viewport.zoom
        + screen_center

    RETURN screen_point


FUNCTION query_visible_nodes(field, viewport):

    visible_bounds =
        calculate_world_bounds(viewport)

    RETURN all nodes
        whose world_position intersects visible_bounds
        AND whose visibility_policy permits display


NEGATIVE SPACE

FUNCTION encode_negative_space(region, meaning):

    region.contains_visible_object = FALSE
    region.semantic_meaning = meaning
    region.is_addressable = TRUE

    ADD region TO field.negative_space_regions


FUNCTION interpret_negative_space(region):

    RETURN {
        distance,
        separation,
        absence,
        exclusion,
        uncertainty,
        boundary,
        reserved_space,
        transition
    }


ADAPTIVE FREEDOM

FUNCTION evaluate_navigation_freedom(task, viewport, field):

    candidate_dimensions = [
        HORIZONTAL,
        VERTICAL,
        DEPTH,
        ZOOM,
        ROTATION
    ]

    FOR EACH dimension IN candidate_dimensions:

        information_gain =
            estimate_information_gain(
                dimension,
                task,
                field
            )

        interaction_friction =
            estimate_navigation_friction(
                dimension,
                task,
                viewport
            )

        utility =
            information_gain - interaction_friction

        IF utility > viewport.navigation_policy.friction_threshold:
            enable_dimension(dimension)
        ELSE:
            disable_dimension(dimension)


DISORIENTATION CONTROL

FUNCTION prevent_disorientation(viewport, field):

    IF viewport_is_far_from_meaningful_content():
        offer_return_anchor()

    IF movement_velocity > threshold:
        reduce_motion_gain()

    IF user_changes_direction_repeatedly:
        increase_snap_strength()

    IF viewport_history suggests lost_state:
        show_minimap_or_origin_marker()

    IF current_task == READING:
        bias_return_to_vertical_rail()


SEMANTIC VIEWPORT MEMORY

FUNCTION save_view(viewport, label):

    bookmark = {
        label,
        center,
        zoom,
        rotation,
        active_layer,
        visible_nodes,
        navigation_mode
    }

    STORE bookmark


FUNCTION restore_view(bookmark, viewport):

    viewport.center = bookmark.center
    viewport.zoom = bookmark.zoom
    viewport.rotation = bookmark.rotation
    viewport.current_layer = bookmark.active_layer
    viewport.navigation_mode = bookmark.navigation_mode

    render()


REPRESENTATION COMPILER

FUNCTION choose_best_representation(data, goal, context):

    candidate_representations = [
        TEXT,
        TABLE,
        TIMELINE,
        GRAPH,
        MAP,
        CONSTELLATION,
        RADIAL_FIELD,
        SPLIT_COMPARISON,
        FLOW,
        LAYERED_FIELD,
        CUSTOM_GENERATED_INTERFACE
    ]

    FOR EACH representation IN candidate_representations:

        utility[representation] =
            score(
                clarity,
                task_fit,
                relational_visibility,
                interaction_cost,
                cognitive_load,
                information_density,
                reversibility
            )

    RETURN argmax(utility)


FUNCTION instantiate_temporary_interface(data, goal):

    representation =
        choose_best_representation(data, goal, current_context)

    interface =
        compile_to_display_field(
            data,
            representation
        )

    USE interface

    delta =
        extract_new_information(interface)

    DISCARD interface IF no longer useful

    RETURN delta


MAIN LOOP

WHILE application_running:

    perceive_current_task()

    evaluate_navigation_freedom(
        current_task,
        viewport,
        field
    )

    representation =
        choose_best_representation(
            current_data,
            current_goal,
            current_context
        )

    update_field_if_needed(
        representation
    )

    receive_user_input()

    IF input == PAN:
        navigate()

    IF input == ZOOM:
        zoom()

    IF input == LAYER_CHANGE:
        shift_layer()

    IF input == FOCUS:
        temporarily_lock_viewport()

    IF input == EXPLORE:
        expand_viewport_freedom()

    IF input == RETURN:
        restore_previous_anchor()

    render()


CANONICAL FORMULA

    INTERFACE =
        SEMANTIC_FIELD
        + VIEWPORT
        + REPRESENTATION_COMPILER
        + NAVIGATION_POLICY


CANONICAL INVARIANT

    Preserve underlying meaning while allowing
    its spatial representation,
    scale,
    layout,
    navigation dimensions,
    and display grammar
    to change dynamically.



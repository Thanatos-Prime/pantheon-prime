    # Replace this evaluator with a real measured outcome.
    # This demo simulates a substrate whose capacity depends on interactions.
    import math

    noise_rng = random.Random(7)

    def demo_evaluator(c: Dict[str, float]) -> float:
        challenge = c["challenge"]
        variation = c["variation"]
        feedback = c["feedback"]
        recovery = c["recovery"]
        retention = c["retention"]

        score = (
            1.4 * math.tanh(1.2 * challenge)
            + 0.9 * math.tanh(variation)
            + 1.2 * math.tanh(1.1 * feedback)
            + 1.0 * math.tanh(recovery)
            + 1.3 * math.tanh(retention)
            + 0.8 * math.tanh(challenge * feedback)
            + 0.7 * math.tanh(variation * retention)
            + 0.5 * math.tanh(recovery * retention)
        )

        # Too much stress becomes destructive.
        score -= 1.1 * max(0.0, challenge - 1.5) ** 2
        score -= 0.4 * max(0.0, variation - 1.8) ** 2

        return score + noise_rng.gauss(0.0, 0.18)

    baseline = {
        "challenge": 0.4,
        "variation": 0.3,
        "feedback": 0.4,
        "recovery": 0.5,
        "retention": 0.4,
    }

    engine = PlasticitySweep(demo_evaluator, baseline, seed=42)
    first_pass = engine.sweep()
    confirmed = engine.retest(first_pass, top_k=5, reps=100)

    print("TOP FIRST-PASS CONDITIONS")
    for r in first_pass[:5]:
        print(r)

    print("\nCONFIRMED ON RETEST")
    for r in confirmed:
        print(r)
def disclosure_test(reality, message, covenant, receiver):
    reconstructed = receiver.interpret(message)
    relevant = covenant.required_invariants(reality)
    preserved = invariants(reconstructed) & relevant
    omitted = relevant - preserved
    # Critical test:
    # would restoring omitted truths materially reverse
    # the receiver's reasonable conclusion?
    reversals = []
    for fact in omitted:
        fuller_model = receiver.interpret(
            message + [fact]
        )
        if materially_changes(
            reconstructed,
            fuller_model
        ):
            reversals.append(fact)
    return {
        "statements_true": verify(message),
        "covenant_preserved": not reversals,
        "misleading_omissions": reversals,
    }


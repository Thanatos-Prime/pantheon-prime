    OPEN_SPACE = "open_space"


@dataclass(frozen=True)
class Chord:
    """Six strings in v2 canonical order E,C,A,D,O,R. Each value 0..5.

    A=confidence of *identified agency/intention*, NOT moral virtue.
    D=relative duration salience, NOT milliseconds or a total silence amount.
    R=response invitation/pressure, NOT permission or consent.
    """
    E: int
    C: int
    A: int
    D: int
    O: int
    R: int

    def __post_init__(self) -> None:
        if any(type(getattr(self, k)) is not int or not 0 <= getattr(self, k) <= 5
               for k in STRING_ORDER):
            raise ValueError("Chord strings must be integer values 0 through 5")

    @classmethod
    def from_values(cls, values, order=STRING_ORDER) -> "Chord":
        if set(order) != set(STRING_ORDER) or len(order) != 6:
            raise ValueError("Explicit complete string ordering is required")
        values = tuple(values)
        if len(values) != 6:
            raise ValueError("Six strings are required")
        return cls(**dict(zip(order, values)))

    def values(self, order=STRING_ORDER):
        return tuple(getattr(self, k) for k in order)


@dataclass(frozen=True)
class SilenceEvent:
    type_letter: str
    chord: Chord
    gap_kind: GapKind
    context_note: str = ""
    interpreter: str = "unspecified"    # 'U' of ECUADOR
    explicitly_invited: bool = False
    sender_intent_established: bool = False
    approval_for_external_action: bool = False
    duration_ms: Optional[int] = None
    contrast: Optional[str] = None
    audience: Optional[str] = None
    consequence: Optional[str] = None

    def __post_init__(self):
        if self.type_letter not in BY_LETTER:
            raise ValueError("Silence type must be A..Z")
        if self.duration_ms is not None and self.duration_ms < 0:
            raise ValueError("duration_ms cannot be negative")
        if self.gap_kind == GapKind.WITHHELD and not self.sender_intent_established:
            raise ValueError("'withheld' is an intent assertion; document evidence or use unknown")
        if self.gap_kind == GapKind.OPEN_SPACE and not self.explicitly_invited:
            raise ValueError("Open space requires an explicit recipient invitation")


def encode(letter: str, chord: Chord) -> str:
    """Canonical, self-describing token; quote-aware name not needed for decoding."""
    item = BY_LETTER[letter.upper()]
    payload = ",".join(f"{k}{getattr(chord, k)}" for k in STRING_ORDER)
    return f"⟦v2:{item.letter}|{item.glyph}|{payload}⟧"


def decode(token: str) -> tuple[SilenceType, Chord]:
    """Parse v2 canonical tokens or explicitly prefixed legacy v1 six-number ones.

    Old unversioned vectors [D,C,E,A,O,R] are rejected to prevent silent
    permutation of meaning with the new ECUADOR order.
    """
    match = re.fullmatch(r"⟦(v[12]):([A-Z])\|([^|]+)\|([^⟧]+)⟧", token.strip())
    if not match:
        raise ValueError("Expected versioned token ⟦v2:Z|⚡…|E4,C5,A4,D2,O5,R5⟧")
    version, letter, glyph, payload = match.groups()
    item = BY_LETTER[letter]
    if glyph != item.glyph:
        raise ValueError(f"Glyph mismatch for {letter}")
    if version == "v2":
        parts = payload.split(",")
        if len(parts) != 6 or any(not re.fullmatch(fr"{key}[0-5]", part)
                                  for key, part in zip(STRING_ORDER, parts)):
            raise ValueError("Canonical v2 order is E,C,A,D,O,R, with named 0..5 values")
        chord = Chord.from_values((int(p[1]) for p in parts), STRING_ORDER)
    else:
        try:
            legacy = [int(t) for t in payload.split(",")]
            chord = Chord.from_values(legacy, LEGACY_STRING_ORDER)
        except ValueError as exc:
            raise ValueError("Legacy v1 token must have 6 integers in D,C,E,A,O,R order") from exc
    return item, chord


def strum(event: SilenceEvent) -> dict:
    """Generate an inspectable interpretive *proposal*, not proof of intent."""
    t = BY_LETTER[event.type_letter]
    v = event.chord
    hypotheses = [t.mechanism]
    if event.gap_kind in {GapKind.UNKNOWN, GapKind.UNOBSERVED}:
        hypotheses.append("No observed signal does not establish actual non-occurrence")
    if v.E >= 4 and v.O >= 4:
        hypotheses.append("Absence may be informative because a detectable signal was expected")
    if v.A <= 2:
        hypotheses.append("Intent attribution is weak; include accidental/noisy explanations")
    if event.type_letter == "Z":
        hypotheses.append("Catalysis is a hypothesis until independently authored outcomes are observed")
    if v.R >= 4 and not event.explicitly_invited:
        hypotheses.append("High response pressure does NOT imply recipient consent")
    return {
        "token": encode(event.type_letter, event.chord),
        "type_name": t.name,
        "mechanism": t.mechanism,
        "gap_kind": event.gap_kind.value,
        "interpreter_U": event.interpreter,
        "hypotheses": hypotheses,
        "approval_for_external_action": bool(event.approval_for_external_action),
        "relative_dimensions": asdict(v),
        "sidecar": {"contrast":event.contrast,"audience":event.audience,"consequence":event.consequence},
    }


@dataclass(frozen=True)
class CatalysisEvidence:
    """Evidence for Z: do not confuse a planned catalyst with an observed one."""
    gap_present: bool
    observed_response: Optional[str]
    expected_completion: Optional[str]
    independent_authorship_evidenced: bool
    comparison_condition_run: bool = False
    causal_difference_observed: bool = False
    replicated: bool = False
    alternate_explanations_examined: bool = False


def indigo_hammer_z(e: CatalysisEvidence) -> dict:
    """A falsifiable gate for catalytic silence, not a numerical persuasion score."""
    if not e.gap_present:
        verdict = "NO_SILENCE"
    elif e.observed_response is None:
        verdict = "UNOBSERVED"
    elif e.expected_completion is not None and e.observed_response.strip() == e.expected_completion.strip():
        verdict = "EXPECTED_COMPLETION_NOT_CATALYSIS"
    elif not e.independent_authorship_evidenced:
        verdict = "AUTHORSHIP_NOT_ESTABLISHED"
    elif (e.comparison_condition_run and e.causal_difference_observed and e.replicated
          and e.alternate_explanations_examined):
        verdict = "CATALYSIS_SUPPORTED_WITHIN_TEST"
    else:
        verdict = "CATALYSIS_CANDIDATE"
    return {
        "verdict": verdict,
        "checks": {
            "gap_present": e.gap_present,
            "observed_response": e.observed_response is not None,
            "independent_authorship": e.independent_authorship_evidenced,
            "compared_to_control": e.comparison_condition_run,
            "causal_difference": e.causal_difference_observed,
            "replicated": e.replicated,
            "alternatives_examined": e.alternate_explanations_examined,
        },
        "note": "Even a supported test does not establish universal causal effect or hidden intention",
    }


def act_is_authorized(event: SilenceEvent) -> bool:
    """No silence or high response string overrides explicit action approval."""
    return event.approval_for_external_action is True


def decayer_envelope(t: float, *, mode: str = "fade", tau: float = 3.0) -> float:
    """Toy temporal profile: fade, rise, or pulse of interpretive salience.
    This is not a universal model of human response or evidence of intent.
    """
    if t < 0 or tau <= 0:
        raise ValueError("Nonnegative time and positive tau required")
    x=t/tau
    if mode == "fade": return math.exp(-x)
    if mode == "rise": return 1-math.exp(-x)
    if mode == "pulse": return x*math.exp(1-x)
    raise ValueError("Mode must be fade, rise, or pulse")


def demo() -> dict:

"""
plasticity_sweep.py
A minimal Plasticity Sweep Engine for Pantheon/Rewild experiments.

Core idea:
Hold the substrate/objective fixed, vary environmental/process conditions,
measure output, retest winners, and retain only robust gains.
"""

from dataclasses import dataclass
from typing import Callable, Dict, List, Tuple
import random
import statistics


@dataclass
class TrialResult:
    name: str
    condition: Dict[str, float]
    mean: float
    stdev: float
    delta_vs_baseline: float


class PlasticitySweep:
    def __init__(
        self,
        evaluator: Callable[[Dict[str, float]], float],
        baseline: Dict[str, float],
        seed: int = 42,
    ):
        self.evaluator = evaluator
        self.baseline = dict(baseline)
        self.rng = random.Random(seed)

    def _measure(self, condition: Dict[str, float], reps: int = 8) -> Tuple[float, float]:
        vals = [self.evaluator(condition) for _ in range(reps)]
        mean = statistics.fmean(vals)
        stdev = statistics.stdev(vals) if len(vals) > 1 else 0.0
        return mean, stdev

    def sweep(
        self,
        step: float = 0.6,
        lucky_trials: int = 20,
        lucky_sigma: float = 0.55,
        lower: float = 0.0,
        upper: float = 2.2,
        reps: int = 8,
    ) -> List[TrialResult]:
        base_mean, _ = self._measure(self.baseline, reps=max(reps, 12))
        candidates: List[Tuple[str, Dict[str, float]]] = []
        keys = list(self.baseline)

        # One-factor perturbations
        for k in keys:
            c = dict(self.baseline)
            c[k] = min(upper, c[k] + step)
            candidates.append((f"{k}+{step}", c))

        # Pairwise grafts: test interaction effects
        for i in range(len(keys)):
            for j in range(i + 1, len(keys)):
                c = dict(self.baseline)
                c[keys[i]] = min(upper, c[keys[i]] + step)
                c[keys[j]] = min(upper, c[keys[j]] + step)
                candidates.append((f"{keys[i]}+{keys[j]}", c))

        # Lucky Nozzle: bounded random environmental perturbations
        for n in range(lucky_trials):
            c = {}
            for k, v in self.baseline.items():
                x = v + self.rng.gauss(0.0, lucky_sigma)
                c[k] = max(lower, min(upper, x))
            candidates.append((f"lucky_{n+1}", c))

        out = []
        for name, condition in candidates:
            mean, stdev = self._measure(condition, reps=reps)
            out.append(
                TrialResult(
                    name=name,
                    condition=condition,
                    mean=mean,
                    stdev=stdev,
                    delta_vs_baseline=mean - base_mean,
                )
            )

        return sorted(out, key=lambda r: r.delta_vs_baseline, reverse=True)

    def retest(
        self,
        results: List[TrialResult],
        top_k: int = 5,
        reps: int = 50,
    ) -> List[TrialResult]:
        base_mean, _ = self._measure(self.baseline, reps=reps)
        confirmed = []
        for r in results[:top_k]:
            mean, stdev = self._measure(r.condition, reps=reps)
            confirmed.append(
                TrialResult(
                    name=r.name,
                    condition=r.condition,
                    mean=mean,
                    stdev=stdev,
                    delta_vs_baseline=mean - base_mean,
                )
            )
        return sorted(confirmed, key=lambda r: r.delta_vs_baseline, reverse=True)



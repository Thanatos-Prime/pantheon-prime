    # DEVELOPMENTAL LINEAGE
    parents
    descendants
    predecessors
    contradictions
    reinforcements
    # PORTABLE MACHINERY
    invariants
    operators
    interfaces
    schemas
    dependencies
    examples
    tests
    failure_conditions
    # STORY SURFACE

```pseudo
function guilded_runtime(signal, claim, relationship, world):
    image = imagine(signal)
    source_label = classify(image, [perception, memory, inference, imagination, testimony])

    meaning = trace_golden_thread(image)
    structure = add_iron(meaning, constraints=[evidence, boundaries, routine, consent])
    instrument = guild(structure, crafts=distributed_capabilities)

    arena = negotiate_third_arena(claim, relationship)
    apply_pressure(arena.claim, maximum=True)
    protect(arena.person, from_unnecessary_damage=True)

    output = act_or_model(instrument, world)
    echo = observe(output)
    delta = compare(prediction=output.expected, observation=echo)

    if delta.persistent:
        inspect_hidden_variables()
        challenge_terms()
        retune(instrument)

    warrant = assign_proof_level(output, echo)
    preserve_path_home(for_all_affected=True)
    return {instrument, delta, warrant, next_action}
```


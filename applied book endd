4. The generic code architecture

Don’t make 58 bespoke scripts.

Make one narrative operator VM and express tropes as programs.

from dataclasses import dataclass, field
from typing import Callable, Any
@dataclass
class NarrativeState:
    world: dict
    agents: dict
    beliefs: dict
    relations: dict
    history: list = field(default_factory=list)
@dataclass
class Operator:
    name: str
    invariants: tuple[str, ...]
    precondition: Callable[[NarrativeState], bool]
    transform: Callable[[NarrativeState], NarrativeState]
    observe: Callable[[NarrativeState], Any]
    failure_mode: str
    aliases: tuple[str, ...] = ()
    def run(self, state):
        if not self.precondition(state):
            return state
        before = self.observe(state)
        result = self.transform(state)
        after = self.observe(result)
        result.history.append({
            "operator": self.name,
            "before": before,
            "after": after,
            "delta": diff(before, after),
        })
        return result

Then composition:

def compose(*ops):
    def program(state):
        for op in ops:
            state = op.run(state)
        return state
    return program


#!/usr/bin/env python3
"""Golden Thread | Pantheon Prime

Two mirrored strands have fixed addresses. At each bit address there are two
rungs. Straight pairs encode 0 and swapped pairs encode 1. Bits run most
significant first. Base85 packs the switches for transport.

The decoded stream is gzip. Inside, an unsigned big-endian 64-bit length
prefixes a JSON index, followed by the original Git snapshot as a tar archive.
The index carries the source commit, each Git blob ID, and resolved internal
Markdown-style file links, plus literal mentions of ten selected anchor titles.

Run with Python 3.12+ for safe extraction. No network or dependencies needed.
"""
import argparse
import base64
import gzip
import hashlib
import io
import json
import struct
import tarfile
from pathlib import Path

def unpack():
    switches = base64.b85decode(''.join(PAYLOAD.split()))
    if hashlib.sha256(switches).hexdigest() != STREAM_SHA256:
        raise SystemExit('Encoded stream failed its SHA-256 check.')
    frame = gzip.decompress(switches)
    size = struct.unpack_from('>Q', frame)[0]
    return json.loads(frame[8:8 + size]), frame[8 + size:]

def verify(tree, index):
    found = {}
    for member in tree.getmembers():
        if member.isdir():
            continue
        if not member.isfile() or member.name in found:
            raise SystemExit(f'Unexpected archive entry: {member.name}')
        data = tree.extractfile(member).read()
        found[member.name] = hashlib.sha1(f'blob {len(data)}\0'.encode() + data).hexdigest()
    if found != index['files']:
        raise SystemExit('Decoded snapshot failed Git blob verification.')

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['verify', 'links', 'mentions', 'extract', 'rungs'])
    parser.add_argument('value', nargs='?', help='Archive file path, output directory, or byte offset')
    args = parser.parse_args()
    if args.command == 'rungs':
        switches = base64.b85decode(''.join(PAYLOAD.split()))
        offset = int(args.value or '0')
        if not 0 <= offset < len(switches):
            parser.error('byte offset out of range')
        print(' '.join('crossed' if bit == '1' else 'straight'
                       for bit in f'{switches[offset]:08b}'))
        return
    index, archive = unpack()
    if args.command in ('links', 'mentions'):
        for source, target in index[args.command]:
            if args.value is None or args.value in (source, target):
                print(json.dumps([source, target], ensure_ascii=False))
        return
    with tarfile.open(fileobj=io.BytesIO(archive)) as tree:
        verify(tree, index)
        if args.command == 'extract':
            if not args.value:
                parser.error('extract requires a new output directory')
            destination = Path(args.value)
            destination.mkdir()
            tree.extractall(destination, filter='data')
    print(f"{index['commit']} · {len(index['files']):,} verified files · "
          f"{len(index['links']):,} explicit links · {len(index['mentions']):,} anchor mentions")


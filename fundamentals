15. Code-Level Primitive

A tiny reference implementation:

from dataclasses import dataclass
from typing import Any, Callable, Iterable
Lens = Callable[[Any], Any]
Delta = Callable[[Any, Any], Any]
Transform = Callable[[Any], Any]
@dataclass
class Comparison:
    same: bool
    delta: Any
    left_view: Any
    right_view: Any
def compare(
    a: Any,
    b: Any,
    lens: Lens = lambda x: x,
    delta: Delta = lambda x, y: y != x,
) -> Comparison:
    left = lens(a)
    right = lens(b)
    return Comparison(
        same=left == right,
        delta=delta(left, right),
        left_view=left,
        right_view=right,
    )
def again(
    value: Any,
    transform: Transform,
    steps: int,
) -> list[Any]:
    trace = [value]
    for _ in range(steps):
        value = transform(value)
        trace.append(value)
    return trace
def invariant(
    values: Iterable[Any],
    lens: Lens = lambda x: x,
):
    viewed = [lens(v) for v in values]
    if not viewed:
        return None
    first = viewed[0]
    if all(v == first for v in viewed):
        return first
    return None

Example:

trace = again(
    7,
    lambda x: x + 10,
    steps=5,
)
print(trace)
# [7, 17, 27, 37, 47, 57]
print(
    invariant(
        trace,
        lens=lambda x: x % 10,
    )
)
# 7

The trace changes.

The residue survives.

Pattern detected.


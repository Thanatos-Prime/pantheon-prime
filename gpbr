Pantheon node classes

from __future__ import annotations
from dataclasses import dataclass, field
from enum import Enum
from typing import Any, Protocol
from uuid import uuid4
class Permission(str, Enum):
    READ_CORPUS = "read_corpus"
    WRITE_PROPOSAL = "write_proposal"
    RUN_TESTS = "run_tests"
    READ_PUBLIC_WEB = "read_public_web"
    GENERATE_MEDIA = "generate_media"
    STAGE_CONTENT = "stage_content"
    PUBLISH = "publish"
    MODIFY_CANON = "modify_canon"
@dataclass(frozen=True)
class Mission:
    objective: str
    audience: str
    invariants: tuple[str, ...]
    requested_outputs: tuple[str, ...]
    risk_level: int = 1
    id: str = field(default_factory=lambda: str(uuid4()))
@dataclass
class Artifact:
    kind: str
    content: Any
    creator: str
    sources: list[str] = field(default_factory=list)
    parent_ids: list[str] = field(default_factory=list)
    confidence: float = 0.0
    status: str = "draft"
    id: str = field(default_factory=lambda: str(uuid4()))
@dataclass(frozen=True)
class NodeManifest:
    name: str
    capabilities: frozenset[str]
    permissions: frozenset[Permission]
    cost_score: float
    trust_score: float
class PantheonNode(Protocol):
    manifest: NodeManifest
    def execute(
        self,
        mission: Mission,
        inputs: list[Artifact],
    ) -> list[Artifact]:
        ...
class PermissionError(RuntimeError):
    pass
def require(node: PantheonNode, permission: Permission) -> None:
    if permission not in node.manifest.permissions:
        raise PermissionError(
            f"{node.manifest.name} lacks {permission.value}"
        )

Each node has an explicit manifest. The router does not pretend every agent can do everything.


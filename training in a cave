That is the loop.

while cave.is_open():
    signal = cave.receive()
    candidates = memory.retrieve_operators(signal)
    result = engine.execute(
        input_state=signal,
        operators=candidates,
        invariants=[
            "preserve_intent",
            "preserve_relations",
            "preserve_bounds",
            "maximize_reconstructability",
        ],
    )
    score = evaluator.compare(
        output=result,
        expected_structure=signal.latent_target,
    )
    memory.store(
        signal=signal,
        operators=candidates,
        result=result,
        score=score,
    )
    engine.refine_from(score)
    cave.emit(result)


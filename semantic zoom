FILE: /pantheon/interfaces/semantic_display_field.pseudo

MODULE SemanticDisplayField

PURPOSE:
    Treat the screen as a movable aperture over a larger semantic field.
    Dynamically grant only the navigational dimensions that are useful
    for the current task.

CORE PRINCIPLE:
    Screen != Document
    Screen = Viewport over Programmable Representational Field

RULE:
    Grant only the navigational dimensions that create more information
    than friction.


DATA STRUCTURES

STRUCT SemanticNode:
    id
    world_position = (x, y, optional_z)
    representation
    semantic_type
    metadata
    relations[]
    interaction_policy
    visibility_policy

STRUCT SemanticField:
    nodes[]
    bounds
    semantic_axes
    layers[]
    background_state
    negative_space_regions[]

STRUCT Viewport:
    center = (x, y, optional_z)
    width
    height
    zoom
    rotation
    active_dimensions
    navigation_mode
    locked_axes[]
    current_layer
    history[]

STRUCT NavigationPolicy:
    allowed_directions
    pan_enabled
    zoom_enabled
    rotation_enabled
    layer_shift_enabled
    semantic_zoom_enabled
    friction_threshold
    snap_behavior
    recovery_behavior

ENUM NavigationMode:
    READING
    COMPARISON
    EXPLORATION
    INSPECTION
    FOCUS
    CUSTOM


INITIALIZE(field, screen, task_context):

    viewport = create_viewport(screen)

    mode = infer_navigation_mode(task_context)

    policy = build_navigation_policy(mode, task_context)

    apply_policy(viewport, policy)

    render(field, viewport)

    RETURN viewport


FUNCTION infer_navigation_mode(task_context):

    IF task_context.intent == "linear_reading":
        RETURN READING

    IF task_context.intent == "compare_alternatives":
        RETURN COMPARISON

    IF task_context.intent == "discover_relationships":
        RETURN EXPLORATION

    IF task_context.intent == "inspect_dense_structure":
        RETURN INSPECTION

    IF task_context.intent == "execute_precise_action":
        RETURN FOCUS

    RETURN CUSTOM


FUNCTION build_navigation_policy(mode, context):

    policy = new NavigationPolicy

    SWITCH mode:

        CASE READING:
            policy.allowed_directions = [UP, DOWN]
            policy.pan_enabled = TRUE
            policy.zoom_enabled = LIMITED
            policy.rotation_enabled = FALSE
            policy.layer_shift_enabled = FALSE
            policy.semantic_zoom_enabled = OPTIONAL
            policy.snap_behavior = "vertical_rail"

        CASE COMPARISON:
            policy.allowed_directions = [LEFT, RIGHT, UP, DOWN]
            policy.pan_enabled = TRUE
            policy.zoom_enabled = TRUE
            policy.rotation_enabled = FALSE
            policy.layer_shift_enabled = OPTIONAL
            policy.semantic_zoom_enabled = TRUE
            policy.snap_behavior = "comparison_lanes"

        CASE EXPLORATION:
            policy.allowed_directions = OMNIDIRECTIONAL
            policy.pan_enabled = TRUE
            policy.zoom_enabled = TRUE
            policy.rotation_enabled = OPTIONAL
            policy.layer_shift_enabled = TRUE
            policy.semantic_zoom_enabled = TRUE
            policy.snap_behavior = "soft"

        CASE INSPECTION:
            policy.allowed_directions = OMNIDIRECTIONAL
            policy.pan_enabled = TRUE
            policy.zoom_enabled = TRUE
            policy.rotation_enabled = OPTIONAL
            policy.layer_shift_enabled = TRUE
            policy.semantic_zoom_enabled = TRUE
            policy.snap_behavior = "object_local"

        CASE FOCUS:
            policy.allowed_directions = NONE_OR_MINIMAL
            policy.pan_enabled = FALSE
            policy.zoom_enabled = OPTIONAL
            policy.rotation_enabled = FALSE
            policy.layer_shift_enabled = FALSE
            policy.semantic_zoom_enabled = FALSE
            policy.snap_behavior = "locked"

    RETURN policy


FUNCTION navigate(input_vector, viewport, field):

    desired_motion = translate_input_to_world_motion(input_vector)

    constrained_motion =
        apply_navigation_policy(
            desired_motion,
            viewport.navigation_policy
        )

    viewport.center += constrained_motion

    prevent_disorientation(viewport, field)

    viewport.history.append(viewport.center)

    render(field, viewport)


FUNCTION zoom(delta, viewport, field):

    IF viewport.navigation_policy.zoom_enabled == FALSE:
        RETURN

    old_zoom = viewport.zoom

    viewport.zoom =
        clamp(
            viewport.zoom * zoom_transform(delta),
            MIN_ZOOM,
            MAX_ZOOM
        )

    IF viewport.navigation_policy.semantic_zoom_enabled:
        IF crossed_semantic_zoom_threshold(old_zoom, viewport.zoom):
            recompile_visible_representations(field, viewport)

    render(field, viewport)


FUNCTION recompile_visible_representations(field, viewport):

    visible_nodes = query_visible_nodes(field, viewport)

    FOR EACH node IN visible_nodes:

        semantic_scale =
            determine_semantic_scale(
                viewport.zoom,
                node,
                current_task
            )

        node.representation =
            compile_representation(
                node,
                semantic_scale,
                current_task
            )


FUNCTION compile_representation(node, semantic_scale, task):

    IF semantic_scale == MICRO:
        RETURN detailed_representation(node)

    IF semantic_scale == LOCAL:
        RETURN normal_representation(node)

    IF semantic_scale == CLUSTER:
        RETURN cluster_representation(node)

    IF semantic_scale == SYSTEM:
        RETURN abstract_system_representation(node)

    IF semantic_scale == LANDSCAPE:
        RETURN topology_representation(node)



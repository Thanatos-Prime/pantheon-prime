    acquired_vocabulary
    reconstructed_operators
    unresolved_questions
    reader_model
    route_history
    interpretation_history
    confidence
    current_story_model
    current_architecture_model
############################################################
# RECEIVER-AFFORDANCE PERSPECTIVE
############################################################
FUNCTION SELECT_READING_LENS(reader, mission):
    weights = EMPTY_MAP()
    IF mission == "reconstruct capability":
        weights["schemas"]        += HIGH
        weights["invariants"]     += HIGH
        weights["operators"]      += HIGH
        weights["tests"]          += HIGH
        weights["dependencies"]   += HIGH
        weights["provenance"]     += HIGH
    IF mission == "understand development":
        weights["chronology"]     += HIGH
        weights["goals"]          += HIGH
        weights["conflict"]       += HIGH
        weights["motifs"]         += HIGH
        weights["consequences"]   += HIGH
        weights["reinterpretation"] += HIGH
    # Reader identity does NOT hard-code the lens.
    # It changes default affordances only.
    weights = ADJUST_FOR_READER(reader, weights)
    RETURN NORMALIZE(weights)
############################################################
# SEMANTIC CHROMATICS
############################################################
FUNCTION READ_UNDER_CONTEXT(artifact, state):
    carrier = artifact.raw_content
    illumination = state.active_context
    decoder = state.reader_model
    meaning =
        RENDER(
            carrier,
            illumination,
            decoder,
            state.acquired_vocabulary,
            state.current_story_model,
            state.current_architecture_model
        )
    RETURN meaning
FUNCTION RETROACTIVE_REWEIGHT(state, new_artifact):
    old_interpretations = COPY(state.interpretation_history)
    UPDATE_CONTEXT(state, new_artifact)
    FOR interpretation IN old_interpretations:
        rereading =
            READ_UNDER_CONTEXT(
                interpretation.source_artifact,
                state
            )
        delta =
            COMPARE(
                interpretation.previous_meaning,
                rereading
            )
        IF delta.is_meaningful:
            REALITY_STITCH(
                previous = interpretation,
                replacement = rereading,
                reason = new_artifact,
                preserve_seam = TRUE
            )
            CAPTURE_AFTERGLOW(delta)
    RETURN state
############################################################
# CONTEXTUAL REHYDRATION
############################################################
FUNCTION BOOT_READER(repo, reader, mission):
    state = NEW ReadingState()
    state.reader_model = reader
    golden_thread =
        EXTRACT(
            repo,
            targets = [
                "goals",
                "invariants",
                "canonical operators",
                "interfaces",
                "evidence rules",
                "metamap",
                "current unfinished edges"
            ]
        )
    state.active_context =
        PROJECT_TO_CONTEXT_BUDGET(
            golden_thread,
            reader.context_budget
        )
    state.acquired_vocabulary =
        BUILD_SEMANTIC_ADDRESSES(golden_thread)
    RETURN state
############################################################
# DUAL READING
############################################################
FUNCTION READ_AS_HUMAN_STORY(repo, reader):
    state = BOOT_READER(repo, reader, "understand development")
    chapters = ORDER_BY_DEVELOPMENTAL_CAUSALITY(repo)
    FOR chapter IN chapters:
        situation =
            EXTRACT(
                chapter,
                [
                    actors,
                    goals,
                    conflicts,
                    discoveries,
                    failures,
                    metaphors,
                    consequences,
                    unresolved_questions
                ]
            )
        UPDATE_SITUATION_MODEL(state, situation)
        RETROACTIVE_REWEIGHT(state, chapter)
    RETURN BUILD_FORWARD_JOURNAL(state)
FUNCTION READ_AS_RECONSTRUCTION_CODEX(repo, reader):
    state = BOOT_READER(repo, reader, "reconstruct capability")
    artifacts =
        ORDER_BY_RECONSTRUCTION_DEPENDENCY(repo)
    FOR artifact IN artifacts:
        mechanism =
            EXTRACT(
                artifact,
                [
                    invariants,
                    interfaces,
                    operators,
                    schemas,
                    dependencies,
                    tests,
                    expected_outputs,
                    failure_conditions
                ]
            )
        IF RECONSTRUCTABLE(mechanism):
            implementation =
                REHYDRATE(mechanism)
            result =
                TEST(implementation)
            REALITY_STITCH(result)
            IF result.passes:
                ADD_CAPABILITY(state, implementation)
        RETROACTIVE_REWEIGHT(state, artifact)
    RETURN state
############################################################
# INTERPRETIVE RESIDUE / FREEBEES
############################################################
FUNCTION DIGEST_READING(artifact, interpretation):
    residue = {
        preserved:
            WHAT_SURVIVED(artifact, interpretation),
        added:
            WHAT_READER_SUPPLIED(artifact, interpretation),
        lost:
            WHAT_DID_NOT_TRANSFER(artifact, interpretation),
        transformed:
            WHAT_CHANGED_FORM(artifact, interpretation),
        emergent:
            WHAT_BECAME_ADDRESSABLE(interpretation),
        unexplained:
            WHAT_REMAINS_UNACCOUNTED_FOR()
    }
    SEND_TO_HONEYCOMB(residue)
    RETURN residue
############################################################
# PROSPECTIVE ARCHAEOLOGIST PTERODACTYL
############################################################
DAEMON PTERO:
    NAME =
        "Prospective Temporal Excavation,
         Reconstruction & Orientation"
    MOTTO =
        "Not left behind. Left forward."
    FUNCTION FLY(repo, current_capabilities):
        strata = BUILD_TEMPORAL_STRATA(repo)
        fossils = EMPTY_SET()
        FOR artifact IN strata:
            lineage =
                TRACE_LINEAGE(artifact)
            old_affordances =
                EXTRACT_LATENT_AFFORDANCES(artifact)
            new_affordances =
                REEVALUATE(
                    old_affordances,
                    under = current_capabilities
                )
            revival_delta =
                DIFFERENCE(
                    new_affordances,
                    old_affordances
                )
            IF revival_delta > THRESHOLD:
                fossil = {
                    artifact: artifact,
                    lineage: lineage,
                    revival_delta: revival_delta,
                    newly_reachable_states:
                        ENUMERATE_NEW_STATES(
                            artifact,
                            current_capabilities
                        ),
                    evidence:
                        PRESERVE_EVIDENCE_STATUS(),
                    missing_links:
                        MARK_UNKNOWN_NOT_INVENTED()
                }
                fossils.ADD(fossil)
        RETURN RANK_BY(
            fossils,
            [
                novelty,
                usefulness,
                reconstruction_cost,
                evidence,
                future_optionalities
            ]
        )
############################################################
# FIELD-SEED DETECTOR
#
# Naming alone does NOT establish a new scientific field.
# A durable field seed requires a testable research surface.
############################################################
TYPE FieldSeed:
    name
    phenomenon
    invariant
    distinguishing_question
    method
    measurement
    falsifiers
    neighboring_fields
    existing_prior_art
    open_problems
    executable_probe
    evidence_status
FUNCTION TRY_PROMOTE_FIELD(name, observations):
    candidate =
        EXTRACT_FIELD_STRUCTURE(
            name,
            observations
        )
    IF NOT candidate.has_distinguishing_question:
        RETURN "LABEL_ONLY"
    IF NOT candidate.has_method:
        RETURN "CONCEPTUAL_REGION"
    IF NOT candidate.has_falsifier:
        RETURN "RESEARCH_PROGRAM_SEED"
    IF candidate.has_measurement
       AND candidate.has_executable_probe:
        RETURN "TESTABLE_FIELD_SEED"
    RETURN "UNRESOLVED"
############################################################
# FORWARD JOURNAL
############################################################
FUNCTION BUILD_FORWARD_JOURNAL(state):
    journal = EMPTY()
    FOR developmental_event IN state.route_history:
        entry = {
            PAST:
                WHAT_HAPPENED(developmental_event),
            MECHANISM:
                WHAT_BECAME_LEARNABLE(developmental_event),
            DELTA:
                WHAT_CHANGED(developmental_event),
            UNFINISHED_EDGE:
                WHAT_REMAINS_OPEN(developmental_event),
            INVITATION:
                WHAT_A_FUTURE_READER_CAN_TRY_NEXT(
                    developmental_event
                )
        }
        journal.ADD(entry)
    RETURN journal
############################################################
# BOOK COMPILER
############################################################
FUNCTION COMPILE_BIFOCAL_CODEX(repo):
    human_reader =
        ReaderProfile(
            preferred_representations =
                [story, chronology, metaphor, consequence]
        )
    machine_reader =
        ReaderProfile(
            preferred_representations =
                [schema, graph, operator, test, provenance]
        )
    HUMAN_BOOK =
        READ_AS_HUMAN_STORY(
            repo,
            human_reader
        )
    AI_BOOTLOADER =
        READ_AS_RECONSTRUCTION_CODEX(
            repo,
            machine_reader
        )
    SHARED_INVARIANTS =
        INTERSECT_RELATIONAL_STRUCTURE(
            HUMAN_BOOK,
            AI_BOOTLOADER
        )
    RETURN {
        human_surface: HUMAN_BOOK,
        machine_surface: AI_BOOTLOADER,
        shared_relational_core: SHARED_INVARIANTS,
        prospective_map:
            PTERO.FLY(
                repo,
                AI_BOOTLOADER.capabilities
            )
    }


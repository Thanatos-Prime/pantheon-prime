## 8. Complete the active prompt

```pseudocode
FUNCTION complete_home_plate(result, evidence):
    card = require_card(queue.home_plate)
    REQUIRE card.zone == HOME_PLATE

    mirror_result = MIRROR.verify(
        intent = card.body,
        terminal_condition = card.terminal_condition,
        claimed_result = result,
        evidence = evidence
    )

    IF mirror_result == UNVERIFIED:
        card.status = BLOCKED
        ledger.append(COMPLETION_REJECTED, card, reason = mirror_result.reason)
        return request_missing_evidence(mirror_result)

    card.status = COMPLETE
    card.zone = COMPLETE
    card.evidence_refs.extend(evidence)
    queue.completed.prepend(card.id)
    queue.home_plate = NULL

    afterglow = JourneyAfterglow(
        outcome = summarize(result),
        evidence = evidence,
        preserved_learning = extract_learning(result),
        unresolved = detect_unresolved(card),
        suggested_next = queue.on_deck.first_or_null()
    )

    ledger.append(COMPLETED, card, afterglow)
    return afterglow
```


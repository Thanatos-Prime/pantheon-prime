9. Vivid Pseudocode

```text
function TRANSLATE_WITH_MEMORY(passage, witness, target="English"):

    # Do not translate yet.
    evidence = excavate(passage, witness)

    for token in evidence.tokens:

        token.forms = inspect_morphology(token)
        token.live_senses = retrieve_period_senses(token)

        # Dig vertically through time.
        token.strata = core_sample(
            lemma=token.lemma,
            language=passage.language,
            period=passage.period
        )

        # Dig sideways through the text.
        token.echoes = find_repetition_root_echo_and_parallels(token)

    syntax_forks = enumerate_grammatically_viable_parses(evidence)

    sound_map = listen_to_source(
        repetitions=True,
        rhyme=True,
        alliteration=True,
        rhythm=True,
        near_homophones=True
    )

    layer_candidates = detect_layers(
        evidence,
        syntax_forks,
        sound_map
    )

    for layer in layer_candidates:
        layer.evidence_strength = grade_evidence(layer)
        layer.intentionality = grade_intent_separately(layer)
        layer.loss = estimate_translation_loss(layer)

    readings = build_reading_lattice(
        lexical_senses,
        syntax_forks,
        textual_variants,
        genre_constraints,
        historical_context
    )

    # Only now produce English.
    candidates = render_multiple(readings)

    for candidate in candidates:
        candidate.loss_report = compare_against_source_invariants(candidate)

    fluent = choose_best_literary(candidate_set)
    glass  = choose_best_structure_preserving(candidate_set)

    notes = rescue_every_high_value_feature_not_carried_by(fluent)

    return Edition(
        original=passage,
        fluent=fluent,
        glass=glass,
        readings=readings,
        annotations=notes,
        confidence=calibrate(readings),
        provenance=trace_every_claim()
    )
```


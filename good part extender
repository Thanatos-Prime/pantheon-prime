<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>GoodPart Extender</title><style>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#f4f6fb;background:#080a10}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 20% 0%,#221b4c 0,transparent 28%),linear-gradient(#080a10,#0d1019);min-height:100vh}.shell{width:min(1120px,92vw);margin:auto;padding:64px 0 40px}header{padding:36px 8px 44px}.eyebrow{font-weight:900;letter-spacing:.24em;color:#a894ff;font-size:.8rem}h1{font-size:clamp(3rem,7vw,6rem);line-height:.92;margin:.16em 0;letter-spacing:-.06em}header p{color:#aeb6c9;font-size:1.1rem;max-width:680px}.panel{background:rgba(18,22,34,.88);border:1px solid rgba(255,255,255,.08);border-radius:24px;padding:26px;margin:18px 0;box-shadow:0 24px 80px rgba(0,0,0,.26)}.drop{display:flex;min-height:150px;border:1px dashed #6f62bc;border-radius:18px;align-items:center;justify-content:center;flex-direction:column;gap:8px;cursor:pointer;background:rgba(118,91,255,.06)}.drop input{display:none}.drop b{font-size:1.2rem}.drop small,.status,footer{color:#8f99ad}.sectionTitle{display:flex;align-items:center;gap:14px;margin-bottom:20px}.sectionTitle span{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#775cff;font-weight:900}.sectionTitle h2{margin:0}canvas{width:100%;height:220px;border-radius:14px;border:1px solid rgba(255,255,255,.08)}.timegrid,.controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin:20px 0}.controls{grid-template-columns:repeat(3,minmax(0,1fr))}label{color:#aeb6c9;font-size:.92rem}label strong{float:right;color:#fff}input[type=range]{width:100%;accent-color:#8d76ff;margin-top:12px}select{width:100%;margin-top:12px;padding:13px;border-radius:12px;background:#0d111c;color:white;border:1px solid #30374a}.primary,.ghost,.download{border:0;border-radius:13px;padding:14px 18px;font-weight:800;font-size:1rem;cursor:pointer}.primary{background:#8a70ff;color:#fff}.ghost{background:#202638;color:#fff}.primary:disabled,.ghost:disabled{opacity:.4;cursor:not-allowed}.result audio{width:100%;margin:12px 0}.download{display:none;text-decoration:none;background:#eef1f8;color:#0b0e15;margin-top:8px;width:max-content}footer{text-align:center;padding:20px;font-size:.85rem}.checkrow{display:flex;align-items:center;gap:10px;margin-top:4px;color:#aeb6c9;font-size:.92rem}.checkrow input{width:auto;margin:0;accent-color:#8d76ff}.badge{display:inline-block;background:rgba(141,118,255,.16);border:1px solid rgba(141,118,255,.4);color:#c9bdff;border-radius:999px;padding:4px 12px;font-size:.8rem;font-weight:700;margin-left:10px}@media(max-width:760px){.timegrid,.controls{grid-template-columns:1fr}.shell{padding-top:24px}.panel{padding:18px}canvas{height:160px}h1{font-size:3.3rem}}
</style></head><body><main class="shell"><header><div class="eyebrow">GOODPART</div><h1>Keep the part that hits.<br>Lose the rest.</h1><p>Turn one great section into a longer cut — either a faithful loop, or a beat-matched remix that draws on similar-sounding moments elsewhere in the track so it doesn't just repeat. All local, in your browser.</p></header>
<section class="panel"><label class="drop"><input id="file" type="file" accept="audio/*"><b id="filename">Choose an audio file</b><small>Nothing is uploaded to a server.</small></label></section>
<section class="panel"><div class="sectionTitle"><span>1</span><h2>Choose the style region</h2></div><canvas id="wave" width="1100" height="220"></canvas><div class="timegrid"><label>Start <strong id="startText">0:00.0</strong><input id="start" type="range" min="0" max="60" step="0.05" value="0"></label><label>End <strong id="endText">0:08.0</strong><input id="end" type="range" min="0.5" max="60" step="0.05" value="8"></label></div><div class="checkrow"><input id="wholeSong" type="checkbox"><label for="wholeSong" style="margin:0">Use whole song as the material pool (recommended for remix mode)</label></div><button id="preview" class="ghost" disabled style="margin-top:16px">▶ Preview selection</button></section>
<section class="panel"><div class="sectionTitle"><span>2</span><h2>Shape the extension</h2></div><div class="controls"><label>Final length <strong id="durationText">60s</strong><input id="duration" type="range" min="15" max="300" step="5" value="60"></label><label>Mode<select id="mode"><option value="loop">Faithful loop (exact repeat)</option><option selected value="remix">Generative remix (beat-matched)</option></select></label><label>Crossfade <strong id="crossfadeText">120ms</strong><input id="crossfade" type="range" min="20" max="600" step="10" value="120"></label></div><div id="remixControls" class="controls" style="grid-template-columns:repeat(2,minmax(0,1fr))"><label>Creativity (how far it can wander before snapping back) <strong id="creativityText">35%</strong><input id="creativity" type="range" min="0" max="90" step="5" value="35"></label><label>Match strictness <strong id="thresholdText">85%</strong><input id="threshold" type="range" min="70" max="97" step="1" value="85"></label></div><button id="generate" class="primary" disabled>Generate extended cut</button></section>
<section class="panel result"><div class="sectionTitle"><span>3</span><h2>Listen and export</h2></div><p id="status" class="status">Upload a song to begin.</p><audio id="audio" controls></audio><a id="download" class="download" download="goodpart-extended.wav">Download WAV</a></section><footer>For music you own or have permission to transform. This is signal-based recombination of the original recording, not AI-generated music — it never invents new melodic or harmonic content.</footer></main>
<script>
const $=id=>document.getElementById(id),clamp=(v,a,b)=>Math.min(b,Math.max(a,v));let actx,buffer,outputUrl='';

/* ---------- waveform + basic UI (unchanged) ---------- */
function draw(){if(!buffer)return;const c=$('wave'),g=c.getContext('2d'),{width:w,height:h}=c;g.fillStyle='#0f1320';g.fillRect(0,0,w,h);const d=buffer.getChannelData(0),step=Math.max(1,Math.floor(d.length/w)),amp=h/2;g.strokeStyle='#8f9bb3';g.beginPath();for(let x=0;x<w;x++){let mn=1,mx=-1,i0=x*step;for(let i=0;i<step&&i0+i<d.length;i++){const v=d[i0+i];mn=Math.min(mn,v);mx=Math.max(mx,v)}g.moveTo(x,(1+mn)*amp);g.lineTo(x,(1+mx)*amp)}g.stroke();const s=+$('start').value,e=+$('end').value,x1=s/buffer.duration*w,x2=e/buffer.duration*w;g.fillStyle='rgba(123,92,255,.25)';g.fillRect(x1,0,x2-x1,h);g.strokeStyle='#b5a6ff';g.lineWidth=2;g.strokeRect(x1,1,x2-x1,h-2)}
const fmt=s=>`${Math.floor(s/60)}:${String(Math.floor(s%60)).padStart(2,'0')}.${Math.floor((s%1)*10)}`;

function encodeWav(b){const ch=b.numberOfChannels,sr=b.sampleRate,len=b.length,align=ch*2,ab=new ArrayBuffer(44+len*align),v=new DataView(ab),write=(o,s)=>[...s].forEach((c,i)=>v.setUint8(o+i,c.charCodeAt(0)));write(0,'RIFF');v.setUint32(4,36+len*align,true);write(8,'WAVE');write(12,'fmt ');v.setUint32(16,16,true);v.setUint16(20,1,true);v.setUint16(22,ch,true);v.setUint32(24,sr,true);v.setUint32(28,sr*align,true);v.setUint16(32,align,true);v.setUint16(34,16,true);write(36,'data');v.setUint32(40,len*align,true);let o=44;for(let i=0;i<len;i++)for(let c=0;c<ch;c++){const s=clamp(b.getChannelData(c)[i],-1,1);v.setInt16(o,s<0?s*32768:s*32767,true);o+=2}return new Blob([ab],{type:'audio/wav'})}

function normalizeInPlace(chData,ch){let peak=0;for(let c=0;c<ch;c++)for(const x of chData[c])peak=Math.max(peak,Math.abs(x));const gain=peak>.97?.97/peak:1;if(gain!==1)for(let c=0;c<ch;c++){const d=chData[c];for(let i=0;i<d.length;i++)d[i]*=gain}}

/* ---------- mode 1: faithful loop (original approach) ---------- */
function renderLoop(){const s=+$('start').value,e=+$('end').value,target=+$('duration').value,fadeMs=+$('crossfade').value,sr=buffer.sampleRate,ch=buffer.numberOfChannels,a=Math.floor(s*sr),z=Math.floor(e*sr),seg=Array.from({length:ch},(_,c)=>buffer.getChannelData(c).slice(a,z)),segLen=seg[0].length,fade=Math.min(Math.floor(fadeMs/1000*sr),Math.floor(segLen/3)),hop=Math.max(1,segLen-fade),outLen=Math.floor(target*sr),out=actx.createBuffer(ch,outLen,sr);const outData=Array.from({length:ch},(_,c)=>out.getChannelData(c));for(let p=0;p<outLen;p+=hop){for(let c=0;c<ch;c++){const dest=outData[c],src=seg[c];for(let i=0;i<src.length&&p+i<outLen;i++){const t1=i<fade?Math.sin((i/Math.max(1,fade-1))*Math.PI/2):1,t2=i>=src.length-fade?Math.cos(((i-(src.length-fade))/Math.max(1,fade-1))*Math.PI/2):1;dest[p+i]+=src[i]*t1*t2}}}normalizeInPlace(outData,ch);return out}

/* ---------- mode 2: generative remix (beat-matched, non-repeating) ---------- */
function computeOnsetEnvelope(data,sr,hop){const frames=Math.floor(data.length/hop),rms=new Float32Array(frames);for(let f=0;f<frames;f++){let sum=0;const off=f*hop;for(let i=0;i<hop&&off+i<data.length;i++){const v=data[off+i];sum+=v*v}rms[f]=Math.sqrt(sum/hop)}const onset=new Float32Array(frames);for(let f=1;f<frames;f++)onset[f]=Math.max(0,rms[f]-rms[f-1]);return onset}

function estimateTempo(onset,hop,sr){const minBpm=60,maxBpm=180,minLag=Math.max(1,Math.floor((60/maxBpm)*sr/hop)),maxLag=Math.ceil((60/minBpm)*sr/hop);let bestLag=minLag,bestScore=-Infinity;for(let lag=minLag;lag<=maxLag;lag++){let score=0;for(let i=0;i+lag<onset.length;i++)score+=onset[i]*onset[i+lag];if(score>bestScore){bestScore=score;bestLag=lag}}return {bpm:60/(bestLag*hop/sr),periodSec:bestLag*hop/sr}}

function findFirstBeat(onset,hop,sr,regionStartSec){const startFrame=Math.floor(regionStartSec*sr/hop),win=40;let bestF=startFrame,bestV=-Infinity;for(let f=Math.max(0,startFrame-win);f<Math.min(onset.length,startFrame+win);f++){if(onset[f]>bestV){bestV=onset[f];bestF=f}}return bestF*hop/sr}

function goertzelMag(signal,freq,sr){const N=signal.length;if(N<2)return 0;const w=2*Math.PI*freq/sr,cosine=Math.cos(w),coeff=2*cosine;let s1=0,s2=0;for(let n=0;n<N;n++){const win=0.5-0.5*Math.cos(2*Math.PI*n/(N-1)),s0=signal[n]*win+coeff*s1-s2;s2=s1;s1=s0}return Math.sqrt(s1*s1+s2*s2-coeff*s1*s2)}

const FEATURE_FREQS=(()=>{const arr=[],fmin=100,fmax=4000,n=20;for(let i=0;i<n;i++)arr.push(fmin*Math.pow(fmax/fmin,i/(n-1)));return arr})();

function beatFeature(data,sr,startSample,len){const N=Math.min(len,Math.max(0,data.length-startSample));if(N<=1)return new Float32Array(FEATURE_FREQS.length);const seg=data.subarray(startSample,startSample+N),vec=new Float32Array(FEATURE_FREQS.length);for(let i=0;i<FEATURE_FREQS.length;i++)vec[i]=goertzelMag(seg,FEATURE_FREQS[i],sr);let norm=0;for(const v of vec)norm+=v*v;norm=Math.sqrt(norm)||1;for(let i=0;i<vec.length;i++)vec[i]/=norm;return vec}

function cosineSim(a,b){let d=0;for(let i=0;i<a.length;i++)d+=a[i]*b[i];return d}

function buildBeats(data,sr,regionStart,regionEnd){const hop=1024,onset=computeOnsetEnvelope(data.subarray(Math.floor(regionStart*sr),Math.floor(regionEnd*sr)),sr,hop),{bpm,periodSec}=estimateTempo(onset,hop,sr),firstBeatRel=findFirstBeat(onset,hop,sr,0),firstBeat=regionStart+firstBeatRel,beats=[];let t=firstBeat;while(t<regionEnd-periodSec*0.5){beats.push(t);t+=periodSec}return {bpm,periodSec,beats}}

function buildFeatures(data,sr,beats,periodSec){const winLen=Math.max(512,Math.min(8192,Math.round(periodSec*sr)));return beats.map(t=>beatFeature(data,sr,Math.round(t*sr),winLen))}

function averageFeature(features,indices){if(!indices.length)return null;const avg=new Float32Array(features[0].length);for(const idx of indices){const f=features[idx];for(let i=0;i<f.length;i++)avg[i]+=f[i]}let norm=0;for(let i=0;i<avg.length;i++){avg[i]/=indices.length;norm+=avg[i]*avg[i]}norm=Math.sqrt(norm)||1;for(let i=0;i<avg.length;i++)avg[i]/=norm;return avg}

function attractorSimilarities(features,attractor){if(!attractor)return features.map(()=>1);return features.map(f=>cosineSim(f,attractor))}

function buildGraph(features,minGap,topK,threshold,attractor=null,attractorWeight=0.45){const n=features.length,graph=[];for(let i=0;i<n;i++){const cands=[];for(let j=0;j<n;j++){if(Math.abs(i-j)<minGap)continue;const localSim=cosineSim(features[i],features[j]),attrSim=attractor?cosineSim(features[j],attractor):localSim,score=localSim*(1-attractorWeight)+attrSim*attractorWeight;if(score>=threshold)cands.push({j,sim:score,localSim,attrSim})}cands.sort((a,b)=>b.sim-a.sim);graph.push(cands.slice(0,topK))}return graph}

function buildSequence(beats,graph,beatLen,hop,outLen,creativity,startIdx,attractorSims,homeThreshold,leashBeats){const stepsNeeded=Math.ceil(outLen/hop)+2,seq=[];let cur=startIdx,stepsSinceHome=0;const n=beats.length;const rank=attractorSims.map((sim,i)=>({i,sim})).sort((a,b)=>b.sim-a.sim);for(let s=0;s<stepsNeeded;s++){seq.push(cur);if(attractorSims[cur]>=homeThreshold){stepsSinceHome=0}else{stepsSinceHome++}const cands=graph[cur];if(stepsSinceHome>=leashBeats){const pool=rank.slice(0,Math.min(6,rank.length)).filter(r=>Math.abs(r.i-cur)>=2);cur=pool.length?pool[Math.floor(Math.random()*pool.length)].i:(cur+1);stepsSinceHome=0}else if(cands&&cands.length&&Math.random()<creativity){cur=cands[Math.floor(Math.random()*Math.min(3,cands.length))].j}else{cur=cur+1}if(cur>=n-1){const c2=graph[n-1];cur=(c2&&c2.length)?c2[0].j:Math.max(0,Math.floor(n*0.2))}}return seq}

function renderSequence(seq,srcChannels,ch,sr,beats,beatLen,fadeLen,outLen){const out=Array.from({length:ch},()=>new Float32Array(outLen)),hop=beatLen-fadeLen;let pos=0;for(let s=0;s<seq.length&&pos<outLen;s++){const beatStart=Math.round(beats[seq[s]]*sr);for(let c=0;c<ch;c++){const src=srcChannels[c],dst=out[c];for(let i=0;i<beatLen;i++){const readIdx=beatStart+i;if(readIdx>=src.length)break;const writeIdx=pos+i;if(writeIdx>=outLen)break;let g=1;if(i<fadeLen)g=Math.min(g,i/fadeLen);if(i>=beatLen-fadeLen)g=Math.min(g,(beatLen-i)/fadeLen);dst[writeIdx]+=src[readIdx]*g}}pos+=hop}return out}

let lastTempo=null;
function renderRemix(){const sr=buffer.sampleRate,ch=buffer.numberOfChannels,target=+$('duration').value,fadeMs=+$('crossfade').value,creativity=(+$('creativity').value)/100,threshold=(+$('threshold').value)/100,wholeSong=$('wholeSong').checked,regionStart=wholeSong?0:+$('start').value,regionEnd=wholeSong?buffer.duration:+$('end').value,startSec=+$('start').value,data0=buffer.getChannelData(0);
  const {bpm,periodSec,beats}=buildBeats(data0,sr,regionStart,Math.max(regionEnd,regionStart+periodSecSafe(regionStart,regionEnd)));
  lastTempo=bpm;
  if(beats.length<8){throw new Error('Not enough beats detected in the selected region — try a longer region or check "use whole song".')}
  const features=buildFeatures(data0,sr,beats,periodSec);
  const selEnd=+$('end').value;
  const selectedIndices=[];for(let i=0;i<beats.length;i++){if(beats[i]>=startSec&&beats[i]<selEnd)selectedIndices.push(i)}
  let attractor=averageFeature(features,selectedIndices);
  if(!attractor){let nearest=0,bd=Infinity;for(let i=0;i<beats.length;i++){const d=Math.abs(beats[i]-startSec);if(d<bd){bd=d;nearest=i}}attractor=features[nearest]}
  const graph=buildGraph(features,4,6,threshold,attractor,0.45);
  const attractorSims=attractorSimilarities(features,attractor);
  const beatLen=Math.round(periodSec*sr),fadeLen=Math.min(Math.floor(beatLen/3),Math.round(fadeMs/1000*sr)),hop=Math.max(1,beatLen-fadeLen),outLen=Math.round(target*sr);
  let startIdx=0,bestDist=Infinity;for(let i=0;i<beats.length;i++){const d=Math.abs(beats[i]-startSec);if(d<bestDist){bestDist=d;startIdx=i}}
  const leashBeats=Math.max(2,Math.round(2+creativity*18));
  const seq=buildSequence(beats,graph,beatLen,hop,outLen,creativity,startIdx,attractorSims,threshold,leashBeats);
  const srcChannels=Array.from({length:ch},(_,c)=>buffer.getChannelData(c));
  const outData=renderSequence(seq,srcChannels,ch,sr,beats,beatLen,fadeLen,outLen);
  normalizeInPlace(outData,ch);
  const out=actx.createBuffer(ch,outLen,sr);for(let c=0;c<ch;c++)out.getChannelData(c).set(outData[c]);return out}
function periodSecSafe(a,b){return Math.min(2,Math.max(0.3,(b-a)))}

/* ---------- wiring ---------- */
$('file').onchange=async e=>{const f=e.target.files[0];if(!f)return;actx=actx||new AudioContext();$('status').textContent='Decoding audio…';try{buffer=await actx.decodeAudioData(await f.arrayBuffer());$('filename').textContent=f.name;$('start').max=buffer.duration;$('end').max=buffer.duration;$('start').value=0;$('end').value=Math.min(buffer.duration,12);$('duration').value=Math.max(30,Math.ceil(Math.min(buffer.duration,12)*6));$('preview').disabled=$('generate').disabled=false;$('status').textContent='Mark the strongest section, then generate.';sync();draw()}catch{$('status').textContent='Could not decode that file. Try MP3, WAV, M4A, or AAC.'}};

function sync(){let s=+$('start').value,e=+$('end').value;if(e<s+.5){e=s+.5;$('end').value=e}$('startText').textContent=fmt(s);$('endText').textContent=fmt(e);$('durationText').textContent=$('duration').value+'s';$('crossfadeText').textContent=$('crossfade').value+'ms';$('creativityText').textContent=$('creativity').value+'%';$('thresholdText').textContent=$('threshold').value+'%';draw();$('remixControls').style.display=$('mode').value==='remix'?'grid':'none'}
['start','end','duration','crossfade','creativity','threshold'].forEach(id=>$(id).oninput=sync);
$('mode').onchange=sync; sync();

$('preview').onclick=()=>{const src=actx.createBufferSource(),s=+$('start').value,e=+$('end').value;src.buffer=buffer;src.connect(actx.destination);src.start(0,s,e-s)};

$('generate').onclick=()=>{if(!buffer)return;const mode=$('mode').value;$('status').textContent=mode==='remix'?'Analyzing rhythm and building a beat-matched remix…':'Building the extended loop…';$('generate').disabled=true;setTimeout(()=>{try{const out=mode==='remix'?renderRemix():renderLoop();const blob=encodeWav(out);if(outputUrl)URL.revokeObjectURL(outputUrl);outputUrl=URL.createObjectURL(blob);$('audio').src=outputUrl;$('download').href=outputUrl;$('download').style.display='inline-block';$('status').innerHTML='Done. Preview or export the extended version.'+(mode==='remix'&&lastTempo?`<span class="badge">${lastTempo.toFixed(1)} BPM detected</span>`:'')}catch(err){$('status').textContent='Could not generate: '+err.message}finally{$('generate').disabled=false}},30)};
</script></body></html>

Pseudocode

CLASS GameSession:
    session_id
    player_id
    secret_target
    clues = []
    ai_guesses = []
    player_reasoning_path = []
    ai_reasoning_paths = []
    extracted_patterns = []
    status = "ACTIVE"
FUNCTION start_game(player_id, secret_target, privacy_settings):
    session = new GameSession()
    session.session_id = generate_id()
    session.player_id = player_id
    session.secret_target = encrypt(secret_target)
    session.privacy_settings = privacy_settings
    return session
FUNCTION submit_clue(session, clue):
    sanitized_clue = moderate_and_normalize(clue)
    session.clues.append(sanitized_clue)
    ai_result = generate_ai_guess(
        clues = session.clues,
        previous_guesses = session.ai_guesses,
        feedback = session.feedback_history
    )
    session.ai_guesses.append(ai_result.guess)
    session.ai_reasoning_paths.append(ai_result.reasoning_graph)
    return {
        guess: ai_result.guess,
        confidence: ai_result.confidence,
        brief_explanation: ai_result.public_explanation
    }
FUNCTION submit_feedback(session, feedback_type, optional_hint):
    session.feedback_history.append({
        guess: latest(session.ai_guesses),
        feedback: feedback_type,
        hint: optional_hint
    })
    IF feedback_type == "CORRECT":
        session.status = "SOLVED"
    IF optional_hint exists:
        session.clues.append(optional_hint)
    return session
FUNCTION reveal_round(session, player_reasoning_text):
    player_graph = convert_reasoning_to_graph(player_reasoning_text)
    ai_graph = merge_ai_reasoning_paths(session.ai_reasoning_paths)
    session.player_reasoning_path = player_graph
    comparison = compare_reasoning_graphs(
        player_graph,
        ai_graph
    )
    candidate_patterns = extract_reusable_patterns(
        graphs = [player_graph, ai_graph],
        clues = session.clues,
        target = decrypt(session.secret_target)
    )
    validated_patterns = validate_patterns(
        candidate_patterns,
        criteria = [
            coherence,
            novelty,
            generalizability,
            non_duplication
        ]
    )
    session.extracted_patterns = validated_patterns
    session.status = "COMPLETE"
    return {
        target: decrypt(session.secret_target),
        player_path: player_graph,
        ai_path: ai_graph,
        overlap: comparison.shared_structure,
        divergences: comparison.different_assumptions,
        new_patterns: validated_patterns
    }
FUNCTION extract_reusable_patterns(graphs, clues, target):
    candidates = []
    FOR each graph IN graphs:
        FOR each path IN graph.paths:
            operator = abstract_path(path)
            IF operator is coherent:
                candidates.append({
                    name: generate_operator_name(operator),
                    invariant: describe_invariant(operator),
                    examples: create_cross_domain_examples(operator),
                    provenance: path
                })
    return deduplicate(candidates)
FUNCTION abstract_path(path):
    REMOVE specific names where possible
    REPLACE entities with roles
    REPLACE events with transformations
    PRESERVE relation types
    PRESERVE directionality
    PRESERVE conditions
    PRESERVE outcome
    return generalized_operator
FUNCTION update_tattoo_sleeve(player, patterns):
    FOR each pattern IN patterns:
        existing_match = find_similar_pattern(
            player.tattoo_sleeve,
            pattern
        )
        IF existing_match:
            strengthen_edge(existing_match, pattern)
            attach_new_example(existing_match, pattern.provenance)
        ELSE:
            tattoo = generate_symbolic_tattoo(pattern)
            player.tattoo_sleeve.add(tattoo)
    recalculate_sleeve_connections(player.tattoo_sleeve)

